        mapping(string:mixed) json = ([
            "aggregate" : aggregate,
            "bin" : bin,
            "condition" : condition,
            "field" : field,
            "timeUnit" : time_unit,
            "type" : type,
            "value" : value,
        ]);

        return Standards.JSON.encode(json);
    }
}

DefWithCondition DefWithCondition_from_JSON(mixed json) {
