    if (json["private"] != Standards.JSON.true && json["private"] != Standards.JSON.false) error("Expected bool");
    retval.repo_private = json["private"];
    if (!intp(json["size"])) error("Expected integer");
    retval.size = json["size"];
    retval.ssh_url = json["ssh_url"];
    if (!intp(json["stargazers_count"])) error("Expected integer");
    retval.stargazers_count = json["stargazers_count"];
    retval.stargazers_url = json["stargazers_url"];
    retval.statuses_url = json["statuses_url"];
    retval.subscribers_url = json["subscribers_url"];
    retval.subscription_url = json["subscription_url"];
    retval.svn_url = json["svn_url"];
    retval.tags_url = json["tags_url"];
    retval.teams_url = json["teams_url"];
    retval.trees_url = json["trees_url"];
    retval.updated_at = json["updated_at"];
    retval.url = json["url"];
    if (!intp(json["watchers"])) error("Expected integer");
    retval.watchers = json["watchers"];
    if (!intp(json["watchers_count"])) error("Expected integer");
    retval.watchers_count = json["watchers_count"];

    return retval;
}

class MergedBy {
    string avatar_url;          // json: "avatar_url"
    string events_url;          // json: "events_url"
    string followers_url;       // json: "followers_url"
    string following_url;       // json: "following_url"
    string gists_url;           // json: "gists_url"
    string gravatar_id;         // json: "gravatar_id"
    string html_url;            // json: "html_url"
    int    id;                  // json: "id"
    string login;               // json: "login"
    string organizations_url;   // json: "organizations_url"
    string received_events_url; // json: "received_events_url"
    string repos_url;           // json: "repos_url"
    bool   site_admin;          // json: "site_admin"
    string starred_url;         // json: "starred_url"
    string subscriptions_url;   // json: "subscriptions_url"
    string type;                // json: "type"
    string url;                 // json: "url"

    string encode_json() {
        mapping(string:mixed) json = ([
            "avatar_url" : avatar_url,
            "events_url" : events_url,
            "followers_url" : followers_url,
            "following_url" : following_url,
            "gists_url" : gists_url,
            "gravatar_id" : gravatar_id,
            "html_url" : html_url,
            "id" : id,
            "login" : login,
            "organizations_url" : organizations_url,
            "received_events_url" : received_events_url,
            "repos_url" : repos_url,
            "site_admin" : site_admin,
            "starred_url" : starred_url,
            "subscriptions_url" : subscriptions_url,
            "type" : type,
            "url" : url,
        ]);

        return Standards.JSON.encode(json);
    }
}

MergedBy MergedBy_from_JSON(mixed json) {
    MergedBy retval = MergedBy();

    retval.avatar_url = json["avatar_url"];
    retval.events_url = json["events_url"];
    retval.followers_url = json["followers_url"];
    retval.following_url = json["following_url"];
    retval.gists_url = json["gists_url"];
    retval.gravatar_id = json["gravatar_id"];
    retval.html_url = json["html_url"];
    if (!intp(json["id"])) error("Expected integer");
    retval.id = json["id"];
    retval.login = json["login"];
    retval.organizations_url = json["organizations_url"];
    retval.received_events_url = json["received_events_url"];
    retval.repos_url = json["repos_url"];
    if (json["site_admin"] != Standards.JSON.true && json["site_admin"] != Standards.JSON.false) error("Expected bool");
    retval.site_admin = json["site_admin"];
    retval.starred_url = json["starred_url"];
    retval.subscriptions_url = json["subscriptions_url"];
    retval.type = json["type"];
    retval.url = json["url"];

    return retval;
}

class Links {
    Comments comments;        // json: "comments"
    Comments commits;         // json: "commits"
    Comments html;            // json: "html"
    Comments issue;           // json: "issue"
    Comments review_comment;  // json: "review_comment"
    Comments review_comments; // json: "review_comments"
    Comments self;            // json: "self"
    Comments statuses;        // json: "statuses"

    string encode_json() {
        mapping(string:mixed) json = ([
            "comments" : comments,
            "commits" : commits,
            "html" : html,
            "issue" : issue,
            "review_comment" : review_comment,
            "review_comments" : review_comments,
            "self" : self,
            "statuses" : statuses,
        ]);

        return Standards.JSON.encode(json);
    }
}

Links Links_from_JSON(mixed json) {
    Links retval = Links();

    if (!mappingp(json["comments"])) error("Expected object");
    retval.comments = json["comments"];
    if (!mappingp(json["commits"])) error("Expected object");
    retval.commits = json["commits"];
    if (!mappingp(json["html"])) error("Expected object");
    retval.html = json["html"];
    if (!mappingp(json["issue"])) error("Expected object");
    retval.issue = json["issue"];
    if (!mappingp(json["review_comment"])) error("Expected object");
    retval.review_comment = json["review_comment"];
    if (!mappingp(json["review_comments"])) error("Expected object");
    retval.review_comments = json["review_comments"];
    if (!mappingp(json["self"])) error("Expected object");
    retval.self = json["self"];
    if (!mappingp(json["statuses"])) error("Expected object");
    retval.statuses = json["statuses"];

    return retval;
}

class Comments {
    string href; // json: "href"

    string encode_json() {
        mapping(string:mixed) json = ([
            "href" : href,
        ]);

        return Standards.JSON.encode(json);
    }
}

Comments Comments_from_JSON(mixed json) {
    Comments retval = Comments();

    retval.href = json["href"];

    return retval;
}

class TopLevelRepo {
    int    id;   // json: "id"
    string name; // json: "name"
    string url;  // json: "url"

    string encode_json() {
        mapping(string:mixed) json = ([
            "id" : id,
            "name" : name,
            "url" : url,
        ]);

        return Standards.JSON.encode(json);
    }
}

TopLevelRepo TopLevelRepo_from_JSON(mixed json) {
    TopLevelRepo retval = TopLevelRepo();

    if (!intp(json["id"])) error("Expected integer");
    retval.id = json["id"];
    retval.name = json["name"];
    retval.url = json["url"];

    return retval;
}

enum Type {
    PUSH_EVENT = "PushEvent",                // json: "PushEvent"
    CREATE_EVENT = "CreateEvent",            // json: "CreateEvent"
    WATCH_EVENT = "WatchEvent",              // json: "WatchEvent"
    PULL_REQUEST_EVENT = "PullRequestEvent", // json: "PullRequestEvent"
    DELETE_EVENT = "DeleteEvent",            // json: "DeleteEvent"
}

Type Type_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "PushEvent"&&json != "CreateEvent"&&json != "WatchEvent"&&json != "PullRequestEvent"&&json != "DeleteEvent")error("enum");return json;
}
