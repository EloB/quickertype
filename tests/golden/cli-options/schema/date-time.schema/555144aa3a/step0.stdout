//  To parse this JSON data, first install
//
//      json.hpp  https://github.com/nlohmann/json
//
//  Then include this file, and then do
//
//     DateTime data = nlohmann::json::parse(jsonString);
//
//  You can get std::wstring data back out using
//
//     std::wcout << wdump((nlohmann::json) DateTime);

#pragma once

#include <optional>
#include <variant>
#include "json.hpp"

#include <optional>
#include <stdexcept>
#include <regex>
#include <codecvt>
#include <locale>

#ifndef NLOHMANN_OPT_HELPER
#define NLOHMANN_OPT_HELPER
namespace nlohmann {
    template <typename T>
    struct adl_serializer<std::shared_ptr<T>> {
        static void to_json(json & j, const std::shared_ptr<T> & opt) {
            if (!opt) j = nullptr; else j = *opt;
        }

        static std::shared_ptr<T> from_json(const json & j) {
            if (j.is_null()) return std::shared_ptr<T>(); else return std::make_shared<T>(j.get<T>());
        }
    };
    template <typename T>
    struct adl_serializer<std::optional<T>> {
        static void to_json(json & j, const std::optional<T> & opt) {
            if (!opt) j = nullptr; else j = *opt;
        }

        static std::optional<T> from_json(const json & j) {
            if (j.is_null()) return std::optional<T>(); else return std::make_optional<T>(j.get<T>());
        }
    };
}
#endif

namespace quicktype {
    using nlohmann::json;

    template<typename T>
    struct tag {};

    template<typename fromType, typename toType>
    class Utf16_Utf8 {
        private:
        template<typename TF, typename TT>
        static toType convert(tag<std::shared_ptr<TF> >, tag<std::shared_ptr<TT> >, fromType ptr) {
            if (ptr == nullptr) return std::unique_ptr<TT>(); else return std::unique_ptr<TT>(new TT(Utf16_Utf8<TF,TT>::convert(*ptr)));
        }

        template<typename TF, typename TT>
        static toType convert(tag<std::optional<TF> >, tag<std::optional<TT> >, fromType opt) {
            if (!opt) return toType(); else return toType(Utf16_Utf8<TF,TT>::convert(*opt));
        }

        template<typename TF, typename TT>
        static toType convert(tag<std::vector<TF> >, tag<std::vector<TT> >, fromType v) {
            auto it = v.begin();
            auto newVector = std::vector<TT>();
            while (it != v.end()) {
                newVector.push_back(Utf16_Utf8<TF,TT>::convert(*it));
                it++;
            }
            return newVector;
        }

        template<typename KF, typename VF, typename KT, typename VT>
        static toType convert(tag<std::map<KF,VF> >, tag<std::map<KT,VT> >, fromType m) {
            auto it = m.begin();
            auto newMap = std::map<KT, VT>();
            while (it != m.end()) {
                newMap.insert(std::pair<KT, VT>(Utf16_Utf8<KF, KT>::convert(it->first), Utf16_Utf8<VF, VT>::convert(it->second)));
                it++;
            }
            return newMap;
        }

        template<typename TF, typename TT>
        static fromType convert(tag<TF>, tag<TT>, fromType from) {
            return from;
        }

        static std::wstring convert(tag<std::string>, tag<std::wstring>, std::string str) {
            return std::wstring_convert<std::codecvt_utf8_utf16<wchar_t, 0x10ffff, std::little_endian>, wchar_t>{}.from_bytes(str.data());
        }

        static std::string convert(tag<std::wstring>, tag<std::string>, std::wstring str) {
            return std::wstring_convert<std::codecvt_utf8_utf16<wchar_t, 0x10ffff, std::little_endian>, wchar_t>{}.to_bytes(str.data());
        }

        public:
        static toType convert(fromType in) {
            return convert(tag<fromType>(), tag<toType>(), in);
        }
    };

    template<typename T>
    std::wstring wdump(const T& j) {
        std::ostringstream s;
        s << j;
        return Utf16_Utf8<std::string, std::wstring>::convert(s.str()); 
    }

    #ifndef NLOHMANN_UNTYPED_quicktype_HELPER
    #define NLOHMANN_UNTYPED_quicktype_HELPER
    inline json get_untyped(const json & j, const char * property) {
        if (j.find(property) != j.end()) {
            return j.at(property).get<json>();
        }
        return json();
    }

    inline json get_untyped(const json & j, std::string property) {
        return get_untyped(j, property.data());
    }
    #endif

    #ifndef NLOHMANN_OPTIONAL_quicktype_HELPER
    #define NLOHMANN_OPTIONAL_quicktype_HELPER
    template <typename T>
    inline std::shared_ptr<T> get_heap_optional(const json & j, const char * property) {
        auto it = j.find(property);
        if (it != j.end() && !it->is_null()) {
            return j.at(property).get<std::shared_ptr<T>>();
        }
        return std::shared_ptr<T>();
    }

    template <typename T>
    inline std::shared_ptr<T> get_heap_optional(const json & j, std::string property) {
        return get_heap_optional<T>(j, property.data());
    }
    template <typename T>
    inline std::optional<T> get_stack_optional(const json & j, const char * property) {
        auto it = j.find(property);
        if (it != j.end() && !it->is_null()) {
            return j.at(property).get<std::optional<T>>();
        }
        return std::optional<T>();
    }

    template <typename T>
    inline std::optional<T> get_stack_optional(const json & j, std::string property) {
        return get_stack_optional<T>(j, property.data());
    }
    #endif

    enum class ComplexUnionArrayEnum : int { FOO, BAR };

    using ComplexUnionArrayElement = std::variant<std::wstring, ComplexUnionArrayEnum, int64_t>;

    class LocalDate {
        public:
        LocalDate() = default;
        virtual ~LocalDate() = default;

        private:

        public:
    };

    class OffsetDateTime {
        public:
        OffsetDateTime() = default;
        virtual ~OffsetDateTime() = default;

        private:

        public:
    };

    class OffsetTime {
        public:
        OffsetTime() = default;
        virtual ~OffsetTime() = default;

        private:

        public:
    };

    class DateTime {
        public:
        DateTime() = default;
        virtual ~DateTime() = default;

        private:
        std::vector<ComplexUnionArrayElement> complex_union_array;
        std::wstring date;
        std::wstring date_time;
        std::optional<LocalDate> local_date_class;
        std::optional<OffsetDateTime> offset_date_time_class;
        std::optional<OffsetTime> offset_time_class;
        std::wstring time;
        std::vector<std::wstring> union_array;

        public:
        const std::vector<ComplexUnionArrayElement> & get_complex_union_array() const { return complex_union_array; }
        std::vector<ComplexUnionArrayElement> & get_mutable_complex_union_array() { return complex_union_array; }
        void set_complex_union_array(const std::vector<ComplexUnionArrayElement> & value) { this->complex_union_array = value; }

        const std::wstring & get_date() const { return date; }
        std::wstring & get_mutable_date() { return date; }
        void set_date(const std::wstring & value) { this->date = value; }

        const std::wstring & get_date_time() const { return date_time; }
        std::wstring & get_mutable_date_time() { return date_time; }
        void set_date_time(const std::wstring & value) { this->date_time = value; }

        const std::optional<LocalDate> & get_local_date_class() const { return local_date_class; }
        std::optional<LocalDate> & get_mutable_local_date_class() { return local_date_class; }
        void set_local_date_class(const std::optional<LocalDate> & value) { this->local_date_class = value; }

        const std::optional<OffsetDateTime> & get_offset_date_time_class() const { return offset_date_time_class; }
        std::optional<OffsetDateTime> & get_mutable_offset_date_time_class() { return offset_date_time_class; }
        void set_offset_date_time_class(const std::optional<OffsetDateTime> & value) { this->offset_date_time_class = value; }

        const std::optional<OffsetTime> & get_offset_time_class() const { return offset_time_class; }
        std::optional<OffsetTime> & get_mutable_offset_time_class() { return offset_time_class; }
        void set_offset_time_class(const std::optional<OffsetTime> & value) { this->offset_time_class = value; }

        const std::wstring & get_time() const { return time; }
        std::wstring & get_mutable_time() { return time; }
        void set_time(const std::wstring & value) { this->time = value; }

        const std::vector<std::wstring> & get_union_array() const { return union_array; }
        std::vector<std::wstring> & get_mutable_union_array() { return union_array; }
        void set_union_array(const std::vector<std::wstring> & value) { this->union_array = value; }
    };
}

namespace quicktype {
void from_json(const json & j, LocalDate & x);
void to_json(json & j, const LocalDate & x);

void from_json(const json & j, OffsetDateTime & x);
void to_json(json & j, const OffsetDateTime & x);

void from_json(const json & j, OffsetTime & x);
void to_json(json & j, const OffsetTime & x);

void from_json(const json & j, DateTime & x);
void to_json(json & j, const DateTime & x);

void from_json(const json & j, ComplexUnionArrayEnum & x);
void to_json(json & j, const ComplexUnionArrayEnum & x);
}
namespace nlohmann {
template <>
struct adl_serializer<std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t>> {
    static void from_json(const json & j, std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t> & x);
    static void to_json(json & j, const std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t> & x);
};
}
namespace quicktype {
    inline void from_json(const json & j, LocalDate& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        (void)j;
        (void)x;
    }

    inline void to_json(json & j, const LocalDate & x) {
        j = json::object();
        (void)x;
    }

    inline void from_json(const json & j, OffsetDateTime& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        (void)j;
        (void)x;
    }

    inline void to_json(json & j, const OffsetDateTime & x) {
        j = json::object();
        (void)x;
    }

    inline void from_json(const json & j, OffsetTime& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        (void)j;
        (void)x;
    }

    inline void to_json(json & j, const OffsetTime & x) {
        j = json::object();
        (void)x;
    }

    inline void from_json(const json & j, DateTime& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        x.set_complex_union_array(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"complex-union-array")).get<std::vector<ComplexUnionArrayElement>>());
        x.set_date(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"date")).get<std::string>()));
        if (j.find("date-time") != j.end() && !std::regex_match(j.at("date-time").get<std::string>(), std::regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$"))) throw std::runtime_error("Expected date-time");
        x.set_date_time(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"date-time")).get<std::wstring>());
        if (j.find("local-date-class") != j.end() && j.at("local-date-class").is_null()) throw std::runtime_error("Unexpected null");
        x.set_local_date_class(get_stack_optional<LocalDate>(j, Utf16_Utf8<std::wstring, std::string>::convert(L"local-date-class")));
        if (j.find("offset-date-time-class") != j.end() && j.at("offset-date-time-class").is_null()) throw std::runtime_error("Unexpected null");
        x.set_offset_date_time_class(get_stack_optional<OffsetDateTime>(j, Utf16_Utf8<std::wstring, std::string>::convert(L"offset-date-time-class")));
        if (j.find("offset-time-class") != j.end() && j.at("offset-time-class").is_null()) throw std::runtime_error("Unexpected null");
        x.set_offset_time_class(get_stack_optional<OffsetTime>(j, Utf16_Utf8<std::wstring, std::string>::convert(L"offset-time-class")));
        x.set_time(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"time")).get<std::string>()));
        x.set_union_array(Utf16_Utf8<std::vector<std::string>, std::vector<std::wstring>>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"union-array")).get<std::vector<std::string>>()));
    }

    inline void to_json(json & j, const DateTime & x) {
        j = json::object();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"complex-union-array")] = x.get_complex_union_array();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"date")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_date());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"date-time")] = x.get_date_time();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"local-date-class")] = x.get_local_date_class();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"offset-date-time-class")] = x.get_offset_date_time_class();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"offset-time-class")] = x.get_offset_time_class();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"time")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_time());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"union-array")] = Utf16_Utf8<std::vector<std::wstring>, std::vector<std::string>>::convert(x.get_union_array());
    }

    inline void from_json(const json & j, ComplexUnionArrayEnum & x) {
        if (j == Utf16_Utf8<std::wstring, std::string>::convert(L"foo")) x = ComplexUnionArrayEnum::FOO;
        else if (j == Utf16_Utf8<std::wstring, std::string>::convert(L"bar")) x = ComplexUnionArrayEnum::BAR;
        else { throw std::runtime_error("Cannot deserialize to enumeration \"ComplexUnionArrayEnum\""); }
    }

    inline void to_json(json & j, const ComplexUnionArrayEnum & x) {
        switch (x) {
            case ComplexUnionArrayEnum::FOO: j = Utf16_Utf8<std::wstring, std::string>::convert(L"foo"); break;
            case ComplexUnionArrayEnum::BAR: j = Utf16_Utf8<std::wstring, std::string>::convert(L"bar"); break;
            default: throw std::runtime_error("Unexpected value in enumeration \"ComplexUnionArrayEnum\": " + std::to_string(static_cast<int>(x)));
        }
    }
}
namespace nlohmann {
    inline void adl_serializer<std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t>>::from_json(const json & j, std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t> & x) {
        if (j.is_number_integer())
            x = j.get<int64_t>();
        else if (j.is_string())
            x = j.get<std::wstring>();
        else if (j.is_string())
            x = j.get<quicktype::ComplexUnionArrayEnum>();
        else throw std::runtime_error("Could not deserialise!");
    }

    inline void adl_serializer<std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t>>::to_json(json & j, const std::variant<std::wstring, quicktype::ComplexUnionArrayEnum, int64_t> & x) {
        switch (x.index()) {
            case 0:
                j = std::get<std::wstring>(x);
                break;
            case 1:
                j = std::get<quicktype::ComplexUnionArrayEnum>(x);
                break;
            case 2:
                j = std::get<int64_t>(x);
                break;
            default: throw std::runtime_error("Input JSON does not conform to schema!");
        }
    }
}
