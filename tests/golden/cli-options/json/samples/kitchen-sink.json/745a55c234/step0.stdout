}

void cJSON_DeletekitchenSink(struct kitchenSink * x) {
    if (NULL != x) {
        if (NULL != x->string_value) {
            cJSON_free(x->string_value);
        }
        if (NULL != x->date_value) {
            cJSON_free(x->date_value);
        }
        if (NULL != x->uuid_value) {
            cJSON_free(x->uuid_value);
        }
        if (NULL != x->tuples) {
            list_t * x1 = list_get_head(x->tuples);
            while (NULL != x1) {
                struct intOrString * x2 = list_get_head(x1);
                while (NULL != x2) {
                    cJSON_DeleteintOrString(x2);
                    x2 = list_get_next(x1);
                }
                list_release(x1);
                x1 = list_get_next(x->tuples);
            }
            list_release(x->tuples);
        }
        if (NULL != x->person) {
            cJSON_DeletepurplePerson(x->person);
        }
        if (NULL != x->people) {
            struct personElement * x1 = list_get_head(x->people);
            while (NULL != x1) {
                cJSON_DeletepersonElement(x1);
                x1 = list_get_next(x->people);
