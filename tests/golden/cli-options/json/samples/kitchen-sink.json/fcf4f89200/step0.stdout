                    x->MAP_VALUE = x1;
                }
            }
            else {
                x->MAP_VALUE = hashtable_create(64, false);
            }
            if (!cJSON_HasObjectItem(j, "nullableMapValue")) { cJSON_DeleteKitchenSink(x); return NULL; }
            if (cJSON_HasObjectItem(j, "nullableMapValue")) {
