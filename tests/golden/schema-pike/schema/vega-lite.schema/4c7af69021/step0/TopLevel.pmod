    retval.value = json["value"];
    if (arrayp(json["selection"])) error("Unexpected array");
    retval.selection = json["selection"];
    retval.aggregate = json["aggregate"] == Standards.JSON.null ? json["aggregate"] : AggregateOp_from_JSON(json["aggregate"]);
    if (arrayp(json["bin"])) error("Unexpected array");
    retval.bin = json["bin"];
    if (arrayp(json["field"])) error("Unexpected array");
    retval.field = json["field"];
    retval.legend = json["legend"];
    retval.scale = json["scale"];
    if (arrayp(json["sort"])) error("Unexpected array");
