use serde::{Serialize, Deserialize};

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Github1 {
    pub data: Option<Data>,

    pub errors: Option<Vec<Error>>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Data {
    pub viewer: User,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct User {
    pub login: String,

    pub real_name: Option<String>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Error {
    pub message: String,
}
