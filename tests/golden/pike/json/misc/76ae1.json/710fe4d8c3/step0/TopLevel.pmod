    FluffyResponses retval = FluffyResponses();

    if (!mappingp(json["200"])) error("Expected object");
    retval.the_200 = json["200"];

    return retval;
}

class Fluffy200 {
    string       description; // json: "description"
    PurpleSchema schema;      // json: "schema"

    string encode_json() {
        mapping(string:mixed) json = ([
            "description" : description,
            "schema" : schema,
        ]);

        return Standards.JSON.encode(json);
    }
}

Fluffy200 Fluffy200_from_JSON(mixed json) {
    Fluffy200 retval = Fluffy200();

    retval.description = json["description"];
    if (!mappingp(json["schema"])) error("Expected object");
    retval.schema = json["schema"];

    return retval;
}

class PurpleSchema {
    ItemsClass items; // json: "items"
    SchemaType type;  // json: "type"

    string encode_json() {
        mapping(string:mixed) json = ([
            "items" : items,
            "type" : type,
        ]);

        return Standards.JSON.encode(json);
    }
}

PurpleSchema PurpleSchema_from_JSON(mixed json) {
    PurpleSchema retval = PurpleSchema();

    if (!mappingp(json["items"])) error("Expected object");
    retval.items = json["items"];
    retval.type = SchemaType_from_JSON(json["type"]);

    return retval;
}

enum SchemaType {
    ARRAY = "array", // json: "array"
}

SchemaType SchemaType_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "array")error("enum");return json;
}
