# Check out text files with LF on every platform (Windows runners default to
# core.autocrlf=true): sources, test fixtures and the files the build embeds
# are compared or embedded byte for byte.
* text=auto eol=lf

# Golden files are compared byte-for-byte: never touch line endings.
tests/golden/** -text -diff linguist-generated
tests/inputs/** -text linguist-vendored
# graphql-js's introspection query, embedded byte for byte (trailing spaces included).
crates/quicktype-graphql-input/src/graphql/introspection_query.graphql -text
# Stage-level test fixtures are compared byte for byte too (some expected
# outputs contain CRs).
crates/*/tests/fixtures/** -text
# Recorded fuzz cases: inputs and the reference CLI's output, replayed byte
# for byte (CRs in samples, schemas and output included).
tests/fuzz-regressions/** -text
# Generated by dist with CRLF line endings; keep its bytes as generated.
crates/quicktype-cli/wix/main.wxs -text

# GitHub's language statistics: count the port, not the test data or
# quicktype's own TypeScript API, which npm/quicktype-core vendors
# unchanged (all but src/native, which is ours).
crates/*/tests/fixtures/** linguist-generated
crates/quicktype-typescript-input/tests/corpus/** linguist-vendored
tests/fuzz-regressions/** linguist-generated
npm/quicktype-core/src/** linguist-vendored
npm/quicktype-core/src/native/** -linguist-vendored
