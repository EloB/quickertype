// Object for defining datetime in Vega-Lite Filter.
// If both month and quarter are provided, month has higher precedence.
// `day` cannot be combined with other date.
// We accept string for month and day names.
class DateTime {
    float|mixed date;         // json: "date"
    Day         day;          // json: "day"
    float|mixed hours;        // json: "hours"
    float|mixed milliseconds; // json: "milliseconds"
    float|mixed minutes;      // json: "minutes"
    Month       month;        // json: "month"
    float|mixed quarter;      // json: "quarter"
    float|mixed seconds;      // json: "seconds"
    bool|mixed  utc;          // json: "utc"
    float|mixed year;         // json: "year"

    string encode_json() {
        mapping(string:mixed) json = ([
            "date" : date,
            "day" : day,
            "hours" : hours,
            "milliseconds" : milliseconds,
            "minutes" : minutes,
            "month" : month,
            "quarter" : quarter,
            "seconds" : seconds,
            "utc" : utc,
            "year" : year,
        ]);

        return Standards.JSON.encode(json);
    }
}

DateTime DateTime_from_JSON(mixed json) {
    DateTime retval = DateTime();

    if (has_index(json, "date") && json["date"] < 1) error("Value below minimum");
    if (has_index(json, "date") && json["date"] > 31) error("Value above maximum");
    retval.date = json["date"];
    if (arrayp(json["day"])) error("Unexpected array");
    retval.day = json["day"];
    if (has_index(json, "hours") && json["hours"] < 0) error("Value below minimum");
    if (has_index(json, "hours") && json["hours"] > 23) error("Value above maximum");
    retval.hours = json["hours"];
    if (has_index(json, "milliseconds") && json["milliseconds"] < 0) error("Value below minimum");
    if (has_index(json, "milliseconds") && json["milliseconds"] > 999) error("Value above maximum");
    retval.milliseconds = json["milliseconds"];
    if (has_index(json, "minutes") && json["minutes"] < 0) error("Value below minimum");
    if (has_index(json, "minutes") && json["minutes"] > 59) error("Value above maximum");
    retval.minutes = json["minutes"];
    if (arrayp(json["month"])) error("Unexpected array");
    retval.month = json["month"];
    if (has_index(json, "quarter") && json["quarter"] < 1) error("Value below minimum");
    if (has_index(json, "quarter") && json["quarter"] > 4) error("Value above maximum");
    retval.quarter = json["quarter"];
    if (has_index(json, "seconds") && json["seconds"] < 0) error("Value below minimum");
    if (has_index(json, "seconds") && json["seconds"] > 59) error("Value above maximum");
    retval.seconds = json["seconds"];
    retval.utc = json["utc"];
    retval.year = json["year"];

    return retval;
}

// Value representing the day of a week.  This can be one of: (1) integer value -- `1`
