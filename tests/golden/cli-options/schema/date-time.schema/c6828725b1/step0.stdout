{-# LANGUAGE StrictData #-}
{-# LANGUAGE OverloadedStrings #-}

module MyModule
    ( DateTime (..)
    , LocalDate (..)
    , OffsetDateTime (..)
    , OffsetTime (..)
    , ComplexUnionArray (..)
    , decodeTopLevel
    ) where

import Data.Aeson
import Data.Aeson.Types (emptyObject)
import Data.ByteString.Lazy (ByteString)
import Data.HashMap.Strict (HashMap)
import Data.Text (Text)

data DateTime = DateTime
    { complexUnionArrayDateTime :: [ComplexUnionArray]
    , dateDateTime :: Text
    , dateTimeDateTime :: Text
    , localDateClassDateTime :: Maybe LocalDate
    , offsetDateTimeClassDateTime :: Maybe OffsetDateTime
    , offsetTimeClassDateTime :: Maybe OffsetTime
    , timeDateTime :: Text
    , unionArrayDateTime :: [Text]
    } deriving (Show)

data ComplexUnionArray
    = IntegerInComplexUnionArray Int
    | StringInComplexUnionArray Text
    deriving (Show)

data LocalDate = LocalDate
    {
    } deriving (Show)

data OffsetDateTime = OffsetDateTime
    {
    } deriving (Show)

data OffsetTime = OffsetTime
    {
    } deriving (Show)

decodeTopLevel :: ByteString -> Maybe DateTime
decodeTopLevel = decode

instance ToJSON DateTime where
    toJSON (DateTime complexUnionArrayDateTime dateDateTime dateTimeDateTime localDateClassDateTime offsetDateTimeClassDateTime offsetTimeClassDateTime timeDateTime unionArrayDateTime) =
        object $ foldMap (maybe [] pure)
        [ Just $ "complex-union-array" .= complexUnionArrayDateTime
        , Just $ "date" .= dateDateTime
        , Just $ "date-time" .= dateTimeDateTime
        , ("local-date-class" .=) <$> localDateClassDateTime
        , ("offset-date-time-class" .=) <$> offsetDateTimeClassDateTime
        , ("offset-time-class" .=) <$> offsetTimeClassDateTime
        , Just $ "time" .= timeDateTime
        , Just $ "union-array" .= unionArrayDateTime
        ]

instance FromJSON DateTime where
    parseJSON (Object v) = DateTime
        <$> v .: "complex-union-array"
        <*> v .: "date"
        <*> v .: "date-time"
        <*> v .:! "local-date-class"
        <*> v .:! "offset-date-time-class"
        <*> v .:! "offset-time-class"
        <*> v .: "time"
        <*> v .: "union-array"

instance ToJSON ComplexUnionArray where
    toJSON (IntegerInComplexUnionArray x) = toJSON x
    toJSON (StringInComplexUnionArray x) = toJSON x

instance FromJSON ComplexUnionArray where
    parseJSON xs@(Number _) = (fmap IntegerInComplexUnionArray . parseJSON) xs
    parseJSON xs@(String _) = (fmap StringInComplexUnionArray . parseJSON) xs

instance ToJSON LocalDate where
    toJSON = \_ -> emptyObject

instance FromJSON LocalDate where
    parseJSON (Object _) = return LocalDate

instance ToJSON OffsetDateTime where
    toJSON = \_ -> emptyObject

instance FromJSON OffsetDateTime where
    parseJSON (Object _) = return OffsetDateTime

instance ToJSON OffsetTime where
    toJSON = \_ -> emptyObject

instance FromJSON OffsetTime where
    parseJSON (Object _) = return OffsetTime
