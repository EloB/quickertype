    Predicate retval = Predicate();

    if (arrayp(json["not"])) error("Unexpected array");
    retval.not = json["not"];
    retval.and = json["and"];
    retval.or = json["or"];
    if (arrayp(json["equal"])) error("Unexpected array");
    retval.equal = json["equal"];
    retval.field = json["field"];
    retval.time_unit = json["timeUnit"] == Standards.JSON.null ? json["timeUnit"] : TimeUnit_from_JSON(json["timeUnit"]);
    if (has_index(json, "range") && sizeof(json["range"]) < 2) error("Array too short");
    if (has_index(json, "range") && sizeof(json["range"]) > 2) error("Array too long");
    retval.range = json["range"];
    retval.one_of = json["oneOf"];
    if (arrayp(json["selection"])) error("Unexpected array");
    retval.selection = json["selection"];

