+// `QUICKTYPE_BIN` runs a quicktype executable instead of the in-process
+// `main`, with the same options rendered as command-line arguments.  It is a
+// command line split on whitespace, e.g. `/path/to/quicktype` or
+// `node /path/to/quicktype/dist/index.js`.
+const QUICKTYPE_BIN = process.env.QUICKTYPE_BIN;
+
+// The `CLIOptions` the fixtures pass, and their command-line flags.
+const cliStringFlags: Record<string, string> = {
+    srcLang: "--src-lang",
+    lang: "--lang",
+    topLevel: "--top-level",
+    out: "--out",
+    graphqlSchema: "--graphql-schema",
+    telemetry: "--telemetry",
+    debug: "--debug",
+};
+const cliBooleanFlags: Record<string, string> = {
+    alphabetizeProperties: "--alphabetize-properties",
+    allPropertiesOptional: "--all-properties-optional",
+    quiet: "--quiet",
+};
+
+export function cliArgumentsFromOptions(opts: Partial<CLIOptions>): string[] {
+    const args: string[] = [];
+    for (const [key, value] of Object.entries(opts)) {
+        if (value === undefined || key === "src" || key === "rendererOptions") {
+            continue;
+        }
+        if (key in cliStringFlags) {
+            args.push(cliStringFlags[key], String(value));
+        } else if (key in cliBooleanFlags) {
+            if (value) args.push(cliBooleanFlags[key]);
+        } else {
+            throw new Error(`QUICKTYPE_BIN: unsupported CLI option ${key}`);
+        }
+    }
+
+    // In-process, `main` ignores renderer options the language doesn't
+    // have, and accepts "true"/"false" strings for boolean options.  On the
+    // command line a boolean option is `--name` or `--no-name`.
+    const definitions = languageNamed(
+        defined(opts.lang) as LanguageName,
+    ).optionDefinitions;
+    for (const [name, value] of Object.entries(opts.rendererOptions ?? {})) {
+        if (value === undefined) continue;
+        const definition = definitions.find((d) => d.name === name);
+        if (definition === undefined) {
+            console.error(
+                `QUICKTYPE_BIN: ${opts.lang} has no option ${name}; ignored`,
+            );
+            continue;
+        }
+        if (definition.optionType === "boolean") {
+            const on = value !== false && value !== "false" && !!value;
+            args.push(on ? `--${name}` : `--no-${name}`);
+        } else {
+            args.push(`--${name}`, String(value));
+        }
+    }
+
+    for (const src of opts.src ?? []) {
+        args.push(src);
+    }
+    return args;
+}
+
+function quicktypeBin(command: string, opts: Partial<CLIOptions>): void {
+    const [file, ...prefix] = command.trim().split(/\s+/);
+    const args = prefix.concat(cliArgumentsFromOptions(opts));
+    debug(`${command} ${args.join(" ")}`);
+    const result = spawnSync(file, args, {
+        env: process.env,
+        encoding: "utf8",
+        maxBuffer: 1024 * 1024 * 1024,
+    });
+    if (result.error !== undefined || result.status !== 0) {
+        throw new Error(
+            `${command} ${args.join(" ")} failed (status ${result.status}, signal ${result.signal}): ${result.error ?? ""}\n${result.stderr}`,
+        );
+    }
+    if (result.stdout.length > 0) {
+        process.stdout.write(result.stdout);
+    }
+}
+
 export async function quicktype(opts: Partial<CLIOptions>) {
+    if (QUICKTYPE_BIN !== undefined && QUICKTYPE_BIN !== "") {
+        quicktypeBin(QUICKTYPE_BIN, opts);
+        return;
+    }
     await time(async () => {
         await quicktype_(opts);
     });
