{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/TopLevel",
    "definitions": {
        "TopLevel": {
            "type": "object",
            "additionalProperties": {},
            "properties": {
                "intersection": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 5
                },
                "inUnion": {
                    "$ref": "#/definitions/InUnion"
                },
                "maxlength": {
                    "type": "string",
                    "maxLength": 5
                },
                "minlength": {
                    "type": "string",
                    "minLength": 3
                },
                "minMaxIntersection": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 5
                },
                "minmaxlength": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 5
                },
                "minMaxUnion": {
                    "type": "string"
                },
                "union": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 6
                }
            },
            "required": [
                "inUnion",
                "intersection",
                "maxlength",
                "minMaxIntersection",
                "minMaxUnion",
                "minlength",
                "minmaxlength",
                "union"
            ],
            "title": "TopLevel"
        },
        "InUnion": {
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 5
                }
            ],
            "title": "InUnion"
        }
    }
}
