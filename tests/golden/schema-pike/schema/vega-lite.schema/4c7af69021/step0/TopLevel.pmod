// An object hash for defining default properties for each type of selections.
class SelectionConfig {
    IntervalSelectionConfig|mixed interval; // json: "interval"
    MultiSelectionConfig|mixed    multi;    // json: "multi"
    SingleSelectionConfig|mixed   single;   // json: "single"

    string encode_json() {
        mapping(string:mixed) json = ([
            "interval" : interval,
            "multi" : multi,
            "single" : single,
        ]);

        return Standards.JSON.encode(json);
    }
}

SelectionConfig SelectionConfig_from_JSON(mixed json) {
    SelectionConfig retval = SelectionConfig();

    retval.interval = json["interval"];
    retval.multi = json["multi"];
    retval.single = json["single"];

    return retval;
}

// The default definition for an [`interval`](selection.html#type) selection. All properties
// and transformations
// for an interval selection definition (except `type`) may be specified here.
//
// For instance, setting `interval` to `{"translate": false}` disables the ability to move
// interval selections by default.
class IntervalSelectionConfig {
    BindEnum|mixed                bind;      // json: "bind"
    Empty|mixed                   empty;     // json: "empty"
    array(SingleDefChannel)|mixed encodings; // json: "encodings"
    array(string)|mixed           fields;    // json: "fields"
    BrushConfig|mixed             mark;      // json: "mark"
    mixed                         on;        // json: "on"
    SelectionResolution|mixed     resolve;   // json: "resolve"
    Translate                     translate; // json: "translate"
    Translate                     zoom;      // json: "zoom"

    string encode_json() {
        mapping(string:mixed) json = ([
            "bind" : bind,
            "empty" : empty,
            "encodings" : encodings,
            "fields" : fields,
            "mark" : mark,
            "on" : on,
            "resolve" : resolve,
            "translate" : translate,
            "zoom" : zoom,
        ]);

        return Standards.JSON.encode(json);
    }
}

IntervalSelectionConfig IntervalSelectionConfig_from_JSON(mixed json) {
    IntervalSelectionConfig retval = IntervalSelectionConfig();

    retval.bind = json["bind"] == Standards.JSON.null ? json["bind"] : BindEnum_from_JSON(json["bind"]);
    retval.empty = json["empty"] == Standards.JSON.null ? json["empty"] : Empty_from_JSON(json["empty"]);
    retval.encodings = json["encodings"];
    retval.fields = json["fields"];
    retval.mark = json["mark"];
    retval.on = json["on"];
    retval.resolve = json["resolve"] == Standards.JSON.null ? json["resolve"] : SelectionResolution_from_JSON(json["resolve"]);
    if (arrayp(json["translate"])) error("Unexpected array");
    retval.translate = json["translate"];
    if (arrayp(json["zoom"])) error("Unexpected array");
    retval.zoom = json["zoom"];

    return retval;
}

