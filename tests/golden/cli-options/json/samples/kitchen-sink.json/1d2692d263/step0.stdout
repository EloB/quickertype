                        x1 = list_get_next(x->tuples);
                    }
                }
            }
            cJSON_AddItemToObject(j, "person", cJSON_Createpurple_person(x->person));
            if (NULL != x->people) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "people");
                if (NULL != j1) {
                    struct person_element * x1 = list_get_head(x->people);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_Createperson_element(x1));
