// To parse the JSON, install jackson-module-kotlin and do:
//
//   val kitchenSink = KitchenSink.fromJson(jsonString)

package quicktype

import com.fasterxml.jackson.annotation.*
import com.fasterxml.jackson.core.*
import com.fasterxml.jackson.databind.*
import com.fasterxml.jackson.databind.deser.std.StdDeserializer
import com.fasterxml.jackson.databind.module.SimpleModule
import com.fasterxml.jackson.databind.node.*
import com.fasterxml.jackson.databind.ser.std.StdSerializer
import com.fasterxml.jackson.module.kotlin.*


@Suppress("UNCHECKED_CAST")
private fun <T> ObjectMapper.convert(k: kotlin.reflect.KClass<*>, fromJson: (JsonNode) -> T, toJson: (T) -> String, isUnion: Boolean = false) = registerModule(SimpleModule().apply {
    addSerializer(k.java as Class<T>, object : StdSerializer<T>(k.java as Class<T>) {
            override fun serialize(value: T, gen: JsonGenerator, provider: SerializerProvider) = gen.writeRawValue(toJson(value))
    })
    addDeserializer(k.java as Class<T>, object : StdDeserializer<T>(k.java as Class<T>) {
            override fun deserialize(p: JsonParser, ctxt: DeserializationContext) = fromJson(p.readValueAsTree())
    })
})

val mapper = jacksonObjectMapper().apply {
    propertyNamingStrategy = object : PropertyNamingStrategy.PropertyNamingStrategyBase() { override fun translate(name: String) = if (name == "empty") "" else name }
    setSerializationInclusion(JsonInclude.Include.NON_NULL)
    disable(DeserializationFeature.ACCEPT_FLOAT_AS_INT)
    convert(DifferentThingElement::class, { DifferentThingElement.fromJson(it) }, { it.toJson() }, true)
    convert(IntOrString::class,           { IntOrString.fromJson(it) },           { it.toJson() }, true)
}

data class KitchenSink (
    val stringValue: String? = null,
    val dateValue: String? = null,
    val uuidValue: String? = null,

    @get:JsonProperty("name with spaces")@field:JsonProperty("name with spaces")
    val nameWithSpaces: Any? = null,

    val doubleValue: Double? = null,
    val intValue: Long? = null,
    val booleanValue: Boolean? = null,
    val nullValue: Any? = null,
    val tuples: List<List<IntOrString>>? = null,
    val person: PurplePerson? = null,
    val people: List<PersonElement>? = null,
    val differentThings: List<DifferentThingElement>? = null,
    val mapValue: Map<String, Long?>? = null,
    val nullableMapValue: Map<String, Long?>? = null
) {
    fun toJson() = mapper.writeValueAsString(this)

    companion object {
        fun fromJson(json: String) = mapper.readValue<KitchenSink>(json)
    }
}

sealed class DifferentThingElement {
    class DifferentThingClassValue(val value: DifferentThingClass) : DifferentThingElement()
    class IntegerValue(val value: Long)                            : DifferentThingElement()
    class StringValue(val value: String)                           : DifferentThingElement()

    fun toJson(): String = mapper.writeValueAsString(when (this) {
        is DifferentThingClassValue -> this.value
        is IntegerValue             -> this.value
        is StringValue              -> this.value
    })

    companion object {
        fun fromJson(jn: JsonNode): DifferentThingElement = when (jn) {
            is ObjectNode           -> DifferentThingClassValue(mapper.convertValue(jn))
            is IntNode, is LongNode -> IntegerValue(mapper.convertValue(jn))
            is TextNode             -> StringValue(mapper.convertValue(jn))
            else                    -> throw IllegalArgumentException()
        }
    }
}

data class DifferentThingClass (
    val name: String? = null
)

data class PersonElement (
    val name: String? = null,
    val intOrString: IntOrString? = null,
    val optionalValue: Boolean? = null
)

sealed class IntOrString {
    class IntegerValue(val value: Long)  : IntOrString()
    class StringValue(val value: String) : IntOrString()

    fun toJson(): String = mapper.writeValueAsString(when (this) {
        is IntegerValue -> this.value
        is StringValue  -> this.value
    })

    companion object {
        fun fromJson(jn: JsonNode): IntOrString = when (jn) {
            is IntNode, is LongNode -> IntegerValue(mapper.convertValue(jn))
            is TextNode             -> StringValue(mapper.convertValue(jn))
            else                    -> throw IllegalArgumentException()
        }
    }
}

data class PurplePerson (
    val name: String? = null,
    val intOrString: Long? = null
)
