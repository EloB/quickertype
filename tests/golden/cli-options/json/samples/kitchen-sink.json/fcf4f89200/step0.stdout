cJSON * cJSON_CreateKitchenSink(const struct KitchenSink * x) {
    cJSON * j = NULL;
    if (NULL != x) {
        if (NULL != (j = cJSON_CreateObject())) {
            if (NULL != x->STRING_VALUE) {
                cJSON_AddStringToObject(j, "stringValue", x->STRING_VALUE);
            }
            else {
                cJSON_AddStringToObject(j, "stringValue", "");
            }
            if (NULL != x->DATE_VALUE) {
                cJSON_AddStringToObject(j, "dateValue", x->DATE_VALUE);
            }
            else {
                cJSON_AddStringToObject(j, "dateValue", "");
            }
            if (NULL != x->UUID_VALUE) {
                cJSON_AddStringToObject(j, "uuidValue", x->UUID_VALUE);
            }
            else {
                cJSON_AddStringToObject(j, "uuidValue", "");
            }
            cJSON_AddNullToObject(j, "name with spaces");
            cJSON_AddNumberToObject(j, "doubleValue", x->DOUBLE_VALUE);
            cJSON_AddNumberToObject(j, "intValue", x->INT_VALUE);
            cJSON_AddBoolToObject(j, "booleanValue", x->BOOLEAN_VALUE);
            cJSON_AddNullToObject(j, "nullValue");
            if (NULL != x->TUPLES) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "tuples");
                if (NULL != j1) {
                    list_t * x1 = list_get_head(x->TUPLES);
                    while (NULL != x1) {
                        cJSON * j2 = cJSON_CreateArray();
                        if (NULL != j2) {
                            struct IntOrString * x2 = list_get_head(x1);
                            while (NULL != x2) {
                                cJSON_AddItemToArray(j2, cJSON_CreateIntOrString(x2));
                                x2 = list_get_next(x1);
                            }
                        }
                        cJSON_AddItemToArray(j1, j2);
                        x1 = list_get_next(x->TUPLES);
                    }
                }
            }
            cJSON_AddItemToObject(j, "person", cJSON_CreatePurplePerson(x->PERSON));
            if (NULL != x->PEOPLE) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "people");
                if (NULL != j1) {
                    struct PersonElement * x1 = list_get_head(x->PEOPLE);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreatePersonElement(x1));
                        x1 = list_get_next(x->PEOPLE);
                    }
                }
            }
            if (NULL != x->DIFFERENT_THINGS) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "differentThings");
                if (NULL != j1) {
                    struct DifferentThingElement * x1 = list_get_head(x->DIFFERENT_THINGS);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateDifferentThingElement(x1));
                        x1 = list_get_next(x->DIFFERENT_THINGS);
                    }
                }
            }
            if (NULL != x->MAP_VALUE) {
                cJSON * j1 = cJSON_CreateObject();
                if (NULL != j1) {
                    char **keys1 = NULL;
                    size_t count1 = hashtable_get_keys(x->MAP_VALUE, &keys1);
                    if (NULL != keys1) {
                        for (size_t index1 = 0; index1 < count1; index1++) {
                            int64_t *x1 = hashtable_lookup(x->MAP_VALUE, keys1[index1]);
                            if ((void *)0xDEADBEEF != x1) {
                                cJSON_AddItemToObject(j1, keys1[index1], cJSON_CreateNumber(*x1));
                            }
                            else {
                                cJSON_AddItemToObject(j1, keys1[index1], cJSON_CreateNull());
                            }
                        }
                        cJSON_free(keys1);
                    }
                    cJSON_AddItemToObject(j, "mapValue", j1);
                }
            }
            if (NULL != x->NULLABLE_MAP_VALUE) {
                cJSON * j1 = cJSON_CreateObject();
                if (NULL != j1) {
                    char **keys1 = NULL;
                    size_t count1 = hashtable_get_keys(x->NULLABLE_MAP_VALUE, &keys1);
                    if (NULL != keys1) {
                        for (size_t index1 = 0; index1 < count1; index1++) {
                            int64_t *x1 = hashtable_lookup(x->NULLABLE_MAP_VALUE, keys1[index1]);
                            if ((void *)0xDEADBEEF != x1) {
                                cJSON_AddItemToObject(j1, keys1[index1], cJSON_CreateNumber(*x1));
                            }
                            else {
                                cJSON_AddItemToObject(j1, keys1[index1], cJSON_CreateNull());
                            }
                        }
                        cJSON_free(keys1);
                    }
                    cJSON_AddItemToObject(j, "nullableMapValue", j1);
                }
            }
        }
    }
    return j;
}

char * cJSON_PrintKitchenSink(const struct KitchenSink * x) {
    char * s = NULL;
    if (NULL != x) {
        cJSON * j = cJSON_CreateKitchenSink(x);
        if (NULL != j) {
            s = cJSON_Print(j);
            cJSON_Delete(j);
        }
    }
    return s;
}

void cJSON_DeleteKitchenSink(struct KitchenSink * x) {
    if (NULL != x) {
        if (NULL != x->STRING_VALUE) {
            cJSON_free(x->STRING_VALUE);
        }
        if (NULL != x->DATE_VALUE) {
            cJSON_free(x->DATE_VALUE);
        }
        if (NULL != x->UUID_VALUE) {
            cJSON_free(x->UUID_VALUE);
        }
        if (NULL != x->TUPLES) {
            list_t * x1 = list_get_head(x->TUPLES);
            while (NULL != x1) {
                struct IntOrString * x2 = list_get_head(x1);
                while (NULL != x2) {
                    cJSON_DeleteIntOrString(x2);
                    x2 = list_get_next(x1);
                }
                list_release(x1);
                x1 = list_get_next(x->TUPLES);
            }
            list_release(x->TUPLES);
        }
        if (NULL != x->PERSON) {
            cJSON_DeletePurplePerson(x->PERSON);
        }
        if (NULL != x->PEOPLE) {
            struct PersonElement * x1 = list_get_head(x->PEOPLE);
            while (NULL != x1) {
                cJSON_DeletePersonElement(x1);
                x1 = list_get_next(x->PEOPLE);
            }
            list_release(x->PEOPLE);
        }
        if (NULL != x->DIFFERENT_THINGS) {
            struct DifferentThingElement * x1 = list_get_head(x->DIFFERENT_THINGS);
            while (NULL != x1) {
                cJSON_DeleteDifferentThingElement(x1);
                x1 = list_get_next(x->DIFFERENT_THINGS);
            }
            list_release(x->DIFFERENT_THINGS);
        }
        if (NULL != x->MAP_VALUE) {
            char **keys1 = NULL;
            size_t count1 = hashtable_get_keys(x->MAP_VALUE, &keys1);
            if (NULL != keys1) {
                for (size_t index1 = 0; index1 < count1; index1++) {
                    int64_t *x1 = hashtable_lookup(x->MAP_VALUE, keys1[index1]);
                    if (NULL != x1) {
                        if ((void *)0xDEADBEEF != x1) {
                            cJSON_free(x1);
                        }
                    }
                }
                cJSON_free(keys1);
            }
            hashtable_release(x->MAP_VALUE);
        }
        if (NULL != x->NULLABLE_MAP_VALUE) {
            char **keys1 = NULL;
            size_t count1 = hashtable_get_keys(x->NULLABLE_MAP_VALUE, &keys1);
            if (NULL != keys1) {
                for (size_t index1 = 0; index1 < count1; index1++) {
                    int64_t *x1 = hashtable_lookup(x->NULLABLE_MAP_VALUE, keys1[index1]);
                    if (NULL != x1) {
                        if ((void *)0xDEADBEEF != x1) {
                            cJSON_free(x1);
                        }
                    }
                }
                cJSON_free(keys1);
            }
            hashtable_release(x->NULLABLE_MAP_VALUE);
        }
        cJSON_free(x);
    }
}

