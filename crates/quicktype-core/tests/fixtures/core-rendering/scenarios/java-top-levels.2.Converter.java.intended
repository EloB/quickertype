        });
        module.addDeserializer(Date.class, new JsonDeserializer<Date>() {
            @Override
            public Date deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
                String value = jsonParser.getText();
                return Converter.parseAllDateTimeString(value);
            }
        });
        module.addDeserializer(Date.class, new JsonDeserializer<Date>() {
            @Override
            public Date deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
                String value = jsonParser.getText();
                return Converter.parseAllDateTimeString(value);
            }
        });
        mapper.registerModule(module);
        TableReader = mapper.readerFor(Map.class);
        TableWriter = mapper.writerFor(Map.class);
    }

    private static ObjectReader getTableObjectReader() {
        if (TableReader == null) instantiateTableMapper();
        return TableReader;
    }

    private static ObjectWriter getTableObjectWriter() {
        if (TableWriter == null) instantiateTableMapper();
        return TableWriter;
    }

