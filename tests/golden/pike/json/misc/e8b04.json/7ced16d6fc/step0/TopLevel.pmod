class Owner {
    string              display_name;              // json: "displayName"
    array(string)|mixed flags;                     // json: "flags"
    string              id;                        // json: "id"
    int|mixed           last_notification_seen_at; // json: "lastNotificationSeenAt"
    mixed|string        profile_image_url_large;   // json: "profileImageUrlLarge"
    mixed|string        profile_image_url_medium;  // json: "profileImageUrlMedium"
    mixed|string        profile_image_url_small;   // json: "profileImageUrlSmall"
    array(string)|mixed rights;                    // json: "rights"
    RoleName|mixed      role_name;                 // json: "roleName"
    string              screen_name;               // json: "screenName"

    string encode_json() {
        mapping(string:mixed) json = ([
            "displayName" : display_name,
            "flags" : flags,
            "id" : id,
            "lastNotificationSeenAt" : last_notification_seen_at,
            "profileImageUrlLarge" : profile_image_url_large,
            "profileImageUrlMedium" : profile_image_url_medium,
            "profileImageUrlSmall" : profile_image_url_small,
            "rights" : rights,
            "roleName" : role_name,
            "screenName" : screen_name,
        ]);

        return Standards.JSON.encode(json);
    }
}

Owner Owner_from_JSON(mixed json) {
    Owner retval = Owner();

    retval.display_name = json["displayName"];
    retval.flags = json["flags"];
    retval.id = json["id"];
    retval.last_notification_seen_at = json["lastNotificationSeenAt"];
    retval.profile_image_url_large = json["profileImageUrlLarge"];
    retval.profile_image_url_medium = json["profileImageUrlMedium"];
    retval.profile_image_url_small = json["profileImageUrlSmall"];
    retval.rights = json["rights"];
    retval.role_name = json["roleName"] == Standards.JSON.null ? json["roleName"] : RoleName_from_JSON(json["roleName"]);
    retval.screen_name = json["screenName"];

    return retval;
}

