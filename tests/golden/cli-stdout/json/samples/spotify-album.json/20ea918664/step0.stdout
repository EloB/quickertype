void cJSON_DeleteTracks(struct Tracks * x) {
    if (NULL != x) {
        if (NULL != x->href) {
            cJSON_free(x->href);
        }
        if (NULL != x->items) {
            struct Item * x1 = list_get_head(x->items);
            while (NULL != x1) {
                cJSON_DeleteItem(x1);
                x1 = list_get_next(x->items);
            }
            list_release(x->items);
        }
        cJSON_free(x);
    }
}

