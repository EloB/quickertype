{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/TopLevel",
    "definitions": {
        "TopLevel": {
            "type": "object",
            "additionalProperties": {},
            "properties": {
                "exact": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2,
                    "pattern": "^[^!]+$"
                },
                "maximum": {
                    "type": "string",
                    "maxLength": 1
                },
                "minimum": {
                    "type": "string",
                    "minLength": 2
                }
            },
            "required": [
                "exact",
                "maximum",
                "minimum"
            ],
            "title": "TopLevel"
        }
    }
}
