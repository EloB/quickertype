    retval.label_font_size = json["labelFontSize"];
    retval.label_limit = json["labelLimit"];
    if (arrayp(json["labelOverlap"])) error("Unexpected array");
    retval.label_overlap = json["labelOverlap"];
    retval.label_padding = json["labelPadding"];
    retval.labels = json["labels"];
    retval.max_extent = json["maxExtent"];
    retval.min_extent = json["minExtent"];
    retval.short_time_labels = json["shortTimeLabels"];
    retval.tick_color = json["tickColor"];
    retval.tick_round = json["tickRound"];
    retval.ticks = json["ticks"];
    if (has_index(json, "tickSize") && json["tickSize"] < 0) error("Value below minimum");
    retval.tick_size = json["tickSize"];
    if (has_index(json, "tickWidth") && json["tickWidth"] < 0) error("Value below minimum");
    retval.tick_width = json["tickWidth"];
    retval.title_align = json["titleAlign"];
    retval.title_angle = json["titleAngle"];
