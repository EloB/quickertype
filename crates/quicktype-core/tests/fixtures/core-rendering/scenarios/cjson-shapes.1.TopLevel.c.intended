char * cJSON_PrintTopLevel(const struct TopLevel * x) {
    char * s = NULL;
    if (NULL != x) {
        cJSON * j = cJSON_CreateTopLevel(x);
        if (NULL != j) {
            s = cJSON_Print(j);
            cJSON_Delete(j);
        }
    }
    return s;
}

void cJSON_DeleteTopLevel(struct TopLevel * x) {
    if (NULL != x) {
        if (NULL != x->any_val) {
            cJSON_Delete(x->any_val);
        }
        if (NULL != x->arr_any) {
            cJSON * x1 = list_get_head(x->arr_any);
            while (NULL != x1) {
                cJSON_Delete(x1);
                x1 = list_get_next(x->arr_any);
            }
            list_release(x->arr_any);
        }
        if (NULL != x->arr_arr_arr_str) {
            list_t * x1 = list_get_head(x->arr_arr_arr_str);
            while (NULL != x1) {
                list_t * x2 = list_get_head(x1);
                while (NULL != x2) {
                    char * x3 = list_get_head(x2);
                    while (NULL != x3) {
                        cJSON_free(x3);
                        x3 = list_get_next(x2);
                    }
                    list_release(x2);
                    x2 = list_get_next(x1);
                }
                list_release(x1);
                x1 = list_get_next(x->arr_arr_arr_str);
            }
            list_release(x->arr_arr_arr_str);
        }
        if (NULL != x->arr_arr_int) {
            list_t * x1 = list_get_head(x->arr_arr_int);
            while (NULL != x1) {
                int64_t * x2 = list_get_head(x1);
                while (NULL != x2) {
                    cJSON_free(x2);
                    x2 = list_get_next(x1);
                }
                list_release(x1);
                x1 = list_get_next(x->arr_arr_int);
            }
            list_release(x->arr_arr_int);
        }
        if (NULL != x->arr_arr_null_str) {
            list_t * x1 = list_get_head(x->arr_arr_null_str);
            while (NULL != x1) {
                char * x2 = list_get_head(x1);
                while (NULL != x2) {
                    cJSON_free(x2);
                    x2 = list_get_next(x1);
                }
                list_release(x1);
                x1 = list_get_next(x->arr_arr_null_str);
            }
