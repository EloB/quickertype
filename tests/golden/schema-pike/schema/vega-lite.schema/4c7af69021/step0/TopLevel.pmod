            "encodings" : encodings,
            "fields" : fields,
            "nearest" : nearest,
            "on" : on,
            "resolve" : resolve,
        ]);

        return Standards.JSON.encode(json);
    }
}

SingleSelectionConfig SingleSelectionConfig_from_JSON(mixed json) {
    SingleSelectionConfig retval = SingleSelectionConfig();

    retval.bind = json["bind"];
    retval.empty = json["empty"] == Standards.JSON.null ? json["empty"] : Empty_from_JSON(json["empty"]);
    retval.encodings = json["encodings"];
    retval.fields = json["fields"];
    retval.nearest = json["nearest"];
    retval.on = json["on"];
