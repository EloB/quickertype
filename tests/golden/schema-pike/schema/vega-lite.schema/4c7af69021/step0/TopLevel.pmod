VgMarkConfig VgMarkConfig_from_JSON(mixed json) {
    VgMarkConfig retval = VgMarkConfig();

    retval.align = json["align"] == Standards.JSON.null ? json["align"] : HorizontalAlign_from_JSON(json["align"]);
    if (has_index(json, "angle") && json["angle"] < 0) error("Value below minimum");
    if (has_index(json, "angle") && json["angle"] > 360) error("Value above maximum");
    retval.angle = json["angle"];
    retval.baseline = json["baseline"] == Standards.JSON.null ? json["baseline"] : VerticalAlign_from_JSON(json["baseline"]);
    retval.cursor = json["cursor"] == Standards.JSON.null ? json["cursor"] : Cursor_from_JSON(json["cursor"]);
    retval.dx = json["dx"];
    retval.dy = json["dy"];
    retval.fill = json["fill"];
    if (has_index(json, "fillOpacity") && json["fillOpacity"] < 0) error("Value below minimum");
    if (has_index(json, "fillOpacity") && json["fillOpacity"] > 1) error("Value above maximum");
    retval.fill_opacity = json["fillOpacity"];
    retval.font = json["font"];
    if (has_index(json, "fontSize") && json["fontSize"] < 0) error("Value below minimum");
    retval.font_size = json["fontSize"];
    retval.font_style = json["fontStyle"] == Standards.JSON.null ? json["fontStyle"] : FontStyle_from_JSON(json["fontStyle"]);
    if (arrayp(json["fontWeight"])) error("Unexpected array");
    retval.font_weight = json["fontWeight"];
    retval.href = json["href"];
    retval.interpolate = json["interpolate"] == Standards.JSON.null ? json["interpolate"] : Interpolate_from_JSON(json["interpolate"]);
    retval.limit = json["limit"];
    if (has_index(json, "opacity") && json["opacity"] < 0) error("Value below minimum");
    if (has_index(json, "opacity") && json["opacity"] > 1) error("Value above maximum");
    retval.opacity = json["opacity"];
    retval.orient = json["orient"] == Standards.JSON.null ? json["orient"] : Orient_from_JSON(json["orient"]);
    if (has_index(json, "radius") && json["radius"] < 0) error("Value below minimum");
    retval.radius = json["radius"];
    retval.shape = json["shape"];
    if (has_index(json, "size") && json["size"] < 0) error("Value below minimum");
    retval.size = json["size"];
    retval.stroke = json["stroke"];
    retval.stroke_dash = json["strokeDash"];
    retval.stroke_dash_offset = json["strokeDashOffset"];
    if (has_index(json, "strokeOpacity") && json["strokeOpacity"] < 0) error("Value below minimum");
    if (has_index(json, "strokeOpacity") && json["strokeOpacity"] > 1) error("Value above maximum");
    retval.stroke_opacity = json["strokeOpacity"];
    if (has_index(json, "strokeWidth") && json["strokeWidth"] < 0) error("Value below minimum");
    retval.stroke_width = json["strokeWidth"];
    if (has_index(json, "tension") && json["tension"] < 0) error("Value below minimum");
    if (has_index(json, "tension") && json["tension"] > 1) error("Value above maximum");
    retval.tension = json["tension"];
    retval.text = json["text"];
    retval.theta = json["theta"];

    return retval;
}

