            cJSON_AddBoolToObject(j, "booleanValue", x->boolean_value);
            cJSON_AddNullToObject(j, "nullValue");
            if (NULL != x->tuples) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "tuples");
                if (NULL != j1) {
                    list_t * x1 = list_get_head(x->tuples);
                    while (NULL != x1) {
                        cJSON * j2 = cJSON_CreateArray();
