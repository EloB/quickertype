typedef int|Json|string YArrayHeterogeneousJson;

YArrayHeterogeneousJson YArrayHeterogeneousJson_from_JSON(mixed json) {
    return json;
}

class Json {

    string encode_json() {
        mapping(string:mixed) json = ([
        ]);

        return Standards.JSON.encode(json);
    }
}

Json Json_from_JSON(mixed json) {
    Json retval = Json();

    return retval;
}

class YObjectBasicJson {
    string asd; // json: "asd"

    string encode_json() {
        mapping(string:mixed) json = ([
            "asd" : asd,
        ]);

        return Standards.JSON.encode(json);
    }
}

YObjectBasicJson YObjectBasicJson_from_JSON(mixed json) {
    YObjectBasicJson retval = YObjectBasicJson();

    retval.asd = json["asd"];

    return retval;
}

class YObjectEmptyKeyJson {
    int empty; // json: ""

    string encode_json() {
        mapping(string:mixed) json = ([
            "" : empty,
        ]);

        return Standards.JSON.encode(json);
    }
}

YObjectEmptyKeyJson YObjectEmptyKeyJson_from_JSON(mixed json) {
    YObjectEmptyKeyJson retval = YObjectEmptyKeyJson();

    if (!intp(json[""])) error("Expected integer");
    retval.empty = json[""];

    return retval;
}

class YObjectEscapedNullInKeyJson {
    int foo_bar; // json: "foo\u0000bar"

    string encode_json() {
        mapping(string:mixed) json = ([
