class Axis {
    bool|mixed             domain;           // json: "domain"
    mixed|string           format;           // json: "format"
    bool|mixed             grid;             // json: "grid"
    float|mixed            label_angle;      // json: "labelAngle"
    Label                  label_bound;      // json: "labelBound"
    Label                  label_flush;      // json: "labelFlush"
    LabelOverlapUnion      label_overlap;    // json: "labelOverlap"
    float|mixed            label_padding;    // json: "labelPadding"
    bool|mixed             labels;           // json: "labels"
    float|mixed            max_extent;       // json: "maxExtent"
    float|mixed            min_extent;       // json: "minExtent"
    float|mixed            offset;           // json: "offset"
    TitleOrient|mixed      orient;           // json: "orient"
    float|mixed            position;         // json: "position"
    float|mixed            tick_count;       // json: "tickCount"
    bool|mixed             ticks;            // json: "ticks"
    float|mixed            tick_size;        // json: "tickSize"
    mixed|string           title;            // json: "title"
    float|mixed            title_max_length; // json: "titleMaxLength"
    float|mixed            title_padding;    // json: "titlePadding"
    array(AxisValue)|mixed values;           // json: "values"
    float|mixed            zindex;           // json: "zindex"

    string encode_json() {
        mapping(string:mixed) json = ([
            "domain" : domain,
            "format" : format,
            "grid" : grid,
            "labelAngle" : label_angle,
            "labelBound" : label_bound,
            "labelFlush" : label_flush,
            "labelOverlap" : label_overlap,
            "labelPadding" : label_padding,
            "labels" : labels,
            "maxExtent" : max_extent,
            "minExtent" : min_extent,
            "offset" : offset,
            "orient" : orient,
            "position" : position,
            "tickCount" : tick_count,
            "ticks" : ticks,
            "tickSize" : tick_size,
            "title" : title,
            "titleMaxLength" : title_max_length,
            "titlePadding" : title_padding,
            "values" : values,
            "zindex" : zindex,
        ]);

        return Standards.JSON.encode(json);
    }
}

Axis Axis_from_JSON(mixed json) {
    Axis retval = Axis();

    retval.domain = json["domain"];
    retval.format = json["format"];
    retval.grid = json["grid"];
    if (has_index(json, "labelAngle") && json["labelAngle"] < -360) error("Value below minimum");
    if (has_index(json, "labelAngle") && json["labelAngle"] > 360) error("Value above maximum");
    retval.label_angle = json["labelAngle"];
    if (arrayp(json["labelBound"])) error("Unexpected array");
    retval.label_bound = json["labelBound"];
    if (arrayp(json["labelFlush"])) error("Unexpected array");
    retval.label_flush = json["labelFlush"];
    if (arrayp(json["labelOverlap"])) error("Unexpected array");
    retval.label_overlap = json["labelOverlap"];
    retval.label_padding = json["labelPadding"];
    retval.labels = json["labels"];
    retval.max_extent = json["maxExtent"];
    retval.min_extent = json["minExtent"];
    retval.offset = json["offset"];
    retval.orient = json["orient"] == Standards.JSON.null ? json["orient"] : TitleOrient_from_JSON(json["orient"]);
    retval.position = json["position"];
    retval.tick_count = json["tickCount"];
    retval.ticks = json["ticks"];
    if (has_index(json, "tickSize") && json["tickSize"] < 0) error("Value below minimum");
    retval.tick_size = json["tickSize"];
    retval.title = json["title"];
    retval.title_max_length = json["titleMaxLength"];
    retval.title_padding = json["titlePadding"];
    retval.values = json["values"];
    if (has_index(json, "zindex") && json["zindex"] < 0) error("Value below minimum");
    retval.zindex = json["zindex"];

    return retval;
}

