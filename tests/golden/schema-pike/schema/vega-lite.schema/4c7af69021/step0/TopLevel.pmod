// An object that describes what fields should be repeated into views that are laid out as a
// `row` or `column`.
class Repeat {
    array(string)|mixed column; // json: "column"
    array(string)|mixed row;    // json: "row"

    string encode_json() {
        mapping(string:mixed) json = ([
            "column" : column,
            "row" : row,
        ]);

        return Standards.JSON.encode(json);
    }
}

Repeat Repeat_from_JSON(mixed json) {
    Repeat retval = Repeat();

    retval.column = json["column"];
    retval.row = json["row"];

    return retval;
}
