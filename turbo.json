{
    // Turborepo runs the scripts of the workspace's packages (package.json's
    // "workspaces") and caches their results: a task whose inputs (files,
    // the environment variables in `env`, the tasks it depends on) are the
    // same as in an earlier run replays that run's output and files
    // instead of running again. See docs/ARCHITECTURE.md, "Tasks and the
    // cache".
    //
    // This file holds the global options and the tasks' names; each
    // package's own turbo.json (next to its package.json, extending this
    // one) says what its tasks read, write and wait for:
    // crates/turbo.json, tests/golden/turbo.json,
    // npm/quicktype-core/turbo.json and site/turbo.json.
    //
    // Inputs are listed generously there: a file a task reads that is not
    // an input would let a stale result be replayed. Globs given in
    // `inputs` do not skip ignored files (only $TURBO_DEFAULT$, the
    // package's own files, does), so generated folders are excluded by
    // name.
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "stream",
    // Read by tests that print GitHub annotations; they do not change
    // results.
    "globalPassThroughEnv": ["GITHUB_ACTIONS"],
    "tasks": {
        "build": {},
        "lint": {},
        "test": {},
        "test:differential": {},
        "parity": {},
        "generate": {},
        // Removing files is never replayed from the cache.
        "clean": {
            "cache": false
        }
    }
}
