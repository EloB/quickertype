    array(float)|mixed extent;  // json: "extent"
    float|mixed        maxbins; // json: "maxbins"
    float|mixed        minstep; // json: "minstep"
    bool|mixed         nice;    // json: "nice"
    float|mixed        step;    // json: "step"
