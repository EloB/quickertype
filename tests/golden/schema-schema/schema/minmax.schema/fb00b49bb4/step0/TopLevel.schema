{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/TopLevel",
    "definitions": {
        "TopLevel": {
            "type": "object",
            "additionalProperties": {},
            "properties": {
                "free": {
                    "type": "number"
                },
                "intersection": {
                    "type": "number",
                    "minimum": 4,
                    "maximum": 5
                },
                "max": {
                    "type": "number",
                    "maximum": 5
                },
                "min": {
                    "type": "number",
                    "minimum": 3
                },
                "minmax": {
                    "type": "number",
                    "minimum": 3,
                    "maximum": 5
                },
                "minMaxIntersection": {
                    "type": "number",
                    "minimum": 3,
                    "maximum": 5
                },
                "minMaxUnion": {
                    "type": "number"
                },
                "union": {
                    "type": "number",
                    "minimum": 3,
                    "maximum": 6
                }
            },
            "required": [
                "free",
                "intersection",
                "max",
                "min",
                "minMaxIntersection",
                "minMaxUnion",
                "minmax",
                "union"
            ],
            "title": "TopLevel"
        }
    }
}
