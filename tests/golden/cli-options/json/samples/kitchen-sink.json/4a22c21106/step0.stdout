//  To parse this JSON data, first install
//
//      json.hpp  https://github.com/nlohmann/json
//
//  Then include this file, and then do
//
//     KitchenSink data = nlohmann::json::parse(jsonString);
//
//  You can get std::wstring data back out using
//
//     std::wcout << wdump((nlohmann::json) KitchenSink);

#pragma once

#include <optional>
#include <variant>
#include "json.hpp"

#include <optional>
#include <stdexcept>
#include <regex>
#include <codecvt>
#include <locale>

#ifndef NLOHMANN_OPT_HELPER
#define NLOHMANN_OPT_HELPER
namespace nlohmann {
    template <typename T>
    struct adl_serializer<std::shared_ptr<T>> {
        static void to_json(json & j, const std::shared_ptr<T> & opt) {
            if (!opt) j = nullptr; else j = *opt;
        }

        static std::shared_ptr<T> from_json(const json & j) {
            if (j.is_null()) return std::shared_ptr<T>(); else return std::make_shared<T>(j.get<T>());
        }
    };
    template <typename T>
    struct adl_serializer<std::optional<T>> {
        static void to_json(json & j, const std::optional<T> & opt) {
            if (!opt) j = nullptr; else j = *opt;
        }

        static std::optional<T> from_json(const json & j) {
            if (j.is_null()) return std::optional<T>(); else return std::make_optional<T>(j.get<T>());
        }
    };
}
#endif

namespace quicktype {
    using nlohmann::json;

    template<typename T>
    struct tag {};

    template<typename fromType, typename toType>
    class Utf16_Utf8 {
        private:
        template<typename TF, typename TT>
        static toType convert(tag<std::shared_ptr<TF> >, tag<std::shared_ptr<TT> >, fromType ptr) {
            if (ptr == nullptr) return std::unique_ptr<TT>(); else return std::unique_ptr<TT>(new TT(Utf16_Utf8<TF,TT>::convert(*ptr)));
        }

        template<typename TF, typename TT>
        static toType convert(tag<std::optional<TF> >, tag<std::optional<TT> >, fromType opt) {
            if (!opt) return toType(); else return toType(Utf16_Utf8<TF,TT>::convert(*opt));
        }

        template<typename TF, typename TT>
        static toType convert(tag<std::vector<TF> >, tag<std::vector<TT> >, fromType v) {
            auto it = v.begin();
            auto newVector = std::vector<TT>();
            while (it != v.end()) {
                newVector.push_back(Utf16_Utf8<TF,TT>::convert(*it));
                it++;
            }
            return newVector;
        }

        template<typename KF, typename VF, typename KT, typename VT>
        static toType convert(tag<std::map<KF,VF> >, tag<std::map<KT,VT> >, fromType m) {
            auto it = m.begin();
            auto newMap = std::map<KT, VT>();
            while (it != m.end()) {
                newMap.insert(std::pair<KT, VT>(Utf16_Utf8<KF, KT>::convert(it->first), Utf16_Utf8<VF, VT>::convert(it->second)));
                it++;
            }
            return newMap;
        }

        template<typename TF, typename TT>
        static fromType convert(tag<TF>, tag<TT>, fromType from) {
            return from;
        }

        static std::wstring convert(tag<std::string>, tag<std::wstring>, std::string str) {
            return std::wstring_convert<std::codecvt_utf8_utf16<wchar_t, 0x10ffff, std::little_endian>, wchar_t>{}.from_bytes(str.data());
        }

        static std::string convert(tag<std::wstring>, tag<std::string>, std::wstring str) {
            return std::wstring_convert<std::codecvt_utf8_utf16<wchar_t, 0x10ffff, std::little_endian>, wchar_t>{}.to_bytes(str.data());
        }

        public:
        static toType convert(fromType in) {
            return convert(tag<fromType>(), tag<toType>(), in);
        }
    };

    template<typename T>
    std::wstring wdump(const T& j) {
        std::ostringstream s;
        s << j;
        return Utf16_Utf8<std::string, std::wstring>::convert(s.str()); 
    }

    #ifndef NLOHMANN_UNTYPED_quicktype_HELPER
    #define NLOHMANN_UNTYPED_quicktype_HELPER
    inline json get_untyped(const json & j, const char * property) {
        if (j.find(property) != j.end()) {
            return j.at(property).get<json>();
        }
        return json();
    }

    inline json get_untyped(const json & j, std::string property) {
        return get_untyped(j, property.data());
    }
    #endif

    #ifndef NLOHMANN_OPTIONAL_quicktype_HELPER
    #define NLOHMANN_OPTIONAL_quicktype_HELPER
    template <typename T>
    inline std::shared_ptr<T> get_heap_optional(const json & j, const char * property) {
        auto it = j.find(property);
        if (it != j.end() && !it->is_null()) {
            return j.at(property).get<std::shared_ptr<T>>();
        }
        return std::shared_ptr<T>();
    }

    template <typename T>
    inline std::shared_ptr<T> get_heap_optional(const json & j, std::string property) {
        return get_heap_optional<T>(j, property.data());
    }
    template <typename T>
    inline std::optional<T> get_stack_optional(const json & j, const char * property) {
        auto it = j.find(property);
        if (it != j.end() && !it->is_null()) {
            return j.at(property).get<std::optional<T>>();
        }
        return std::optional<T>();
    }

    template <typename T>
    inline std::optional<T> get_stack_optional(const json & j, std::string property) {
        return get_stack_optional<T>(j, property.data());
    }
    #endif

    class DifferentThingClass {
        public:
        DifferentThingClass() = default;
        virtual ~DifferentThingClass() = default;

        private:
        std::wstring name;

        public:
        const std::wstring & get_name() const { return name; }
        std::wstring & get_mutable_name() { return name; }
        void set_name(const std::wstring & value) { this->name = value; }
    };

    using DifferentThingElement = std::variant<DifferentThingClass, int64_t, std::wstring>;

    using IntOrString = std::variant<int64_t, std::wstring>;

    class PersonElement {
        public:
        PersonElement() = default;
        virtual ~PersonElement() = default;

        private:
        std::wstring name;
        IntOrString int_or_string;
        std::optional<bool> optional_value;

        public:
        const std::wstring & get_name() const { return name; }
        std::wstring & get_mutable_name() { return name; }
        void set_name(const std::wstring & value) { this->name = value; }

        const IntOrString & get_int_or_string() const { return int_or_string; }
        IntOrString & get_mutable_int_or_string() { return int_or_string; }
        void set_int_or_string(const IntOrString & value) { this->int_or_string = value; }

        const std::optional<bool> & get_optional_value() const { return optional_value; }
        std::optional<bool> & get_mutable_optional_value() { return optional_value; }
        void set_optional_value(const std::optional<bool> & value) { this->optional_value = value; }
    };

    class PurplePerson {
        public:
        PurplePerson() = default;
        virtual ~PurplePerson() = default;

        private:
        std::wstring name;
        int64_t int_or_string;

        public:
        const std::wstring & get_name() const { return name; }
        std::wstring & get_mutable_name() { return name; }
        void set_name(const std::wstring & value) { this->name = value; }

        const int64_t & get_int_or_string() const { return int_or_string; }
        int64_t & get_mutable_int_or_string() { return int_or_string; }
        void set_int_or_string(const int64_t & value) { this->int_or_string = value; }
    };

    class KitchenSink {
        public:
        KitchenSink() = default;
        virtual ~KitchenSink() = default;

        private:
        std::wstring string_value;
        std::wstring date_value;
        std::wstring uuid_value;
        nlohmann::json name_with_spaces;
        double double_value;
        int64_t int_value;
        bool boolean_value;
        nlohmann::json null_value;
        std::vector<std::vector<IntOrString>> tuples;
        PurplePerson person;
        std::vector<PersonElement> people;
        std::vector<DifferentThingElement> different_things;
        std::map<std::wstring, std::optional<int64_t>> map_value;
        std::map<std::wstring, std::optional<int64_t>> nullable_map_value;

        public:
        const std::wstring & get_string_value() const { return string_value; }
        std::wstring & get_mutable_string_value() { return string_value; }
        void set_string_value(const std::wstring & value) { this->string_value = value; }

        const std::wstring & get_date_value() const { return date_value; }
        std::wstring & get_mutable_date_value() { return date_value; }
        void set_date_value(const std::wstring & value) { this->date_value = value; }

        const std::wstring & get_uuid_value() const { return uuid_value; }
        std::wstring & get_mutable_uuid_value() { return uuid_value; }
        void set_uuid_value(const std::wstring & value) { this->uuid_value = value; }

        const nlohmann::json & get_name_with_spaces() const { return name_with_spaces; }
        nlohmann::json & get_mutable_name_with_spaces() { return name_with_spaces; }
        void set_name_with_spaces(const nlohmann::json & value) { this->name_with_spaces = value; }

        const double & get_double_value() const { return double_value; }
        double & get_mutable_double_value() { return double_value; }
        void set_double_value(const double & value) { this->double_value = value; }

        const int64_t & get_int_value() const { return int_value; }
        int64_t & get_mutable_int_value() { return int_value; }
        void set_int_value(const int64_t & value) { this->int_value = value; }

        const bool & get_boolean_value() const { return boolean_value; }
        bool & get_mutable_boolean_value() { return boolean_value; }
        void set_boolean_value(const bool & value) { this->boolean_value = value; }

        const nlohmann::json & get_null_value() const { return null_value; }
        nlohmann::json & get_mutable_null_value() { return null_value; }
        void set_null_value(const nlohmann::json & value) { this->null_value = value; }

        const std::vector<std::vector<IntOrString>> & get_tuples() const { return tuples; }
        std::vector<std::vector<IntOrString>> & get_mutable_tuples() { return tuples; }
        void set_tuples(const std::vector<std::vector<IntOrString>> & value) { this->tuples = value; }

        const PurplePerson & get_person() const { return person; }
        PurplePerson & get_mutable_person() { return person; }
        void set_person(const PurplePerson & value) { this->person = value; }

        const std::vector<PersonElement> & get_people() const { return people; }
        std::vector<PersonElement> & get_mutable_people() { return people; }
        void set_people(const std::vector<PersonElement> & value) { this->people = value; }

        const std::vector<DifferentThingElement> & get_different_things() const { return different_things; }
        std::vector<DifferentThingElement> & get_mutable_different_things() { return different_things; }
        void set_different_things(const std::vector<DifferentThingElement> & value) { this->different_things = value; }

        const std::map<std::wstring, std::optional<int64_t>> & get_map_value() const { return map_value; }
        std::map<std::wstring, std::optional<int64_t>> & get_mutable_map_value() { return map_value; }
        void set_map_value(const std::map<std::wstring, std::optional<int64_t>> & value) { this->map_value = value; }

        const std::map<std::wstring, std::optional<int64_t>> & get_nullable_map_value() const { return nullable_map_value; }
        std::map<std::wstring, std::optional<int64_t>> & get_mutable_nullable_map_value() { return nullable_map_value; }
        void set_nullable_map_value(const std::map<std::wstring, std::optional<int64_t>> & value) { this->nullable_map_value = value; }
    };
}

namespace quicktype {
void from_json(const json & j, DifferentThingClass & x);
void to_json(json & j, const DifferentThingClass & x);

void from_json(const json & j, PersonElement & x);
void to_json(json & j, const PersonElement & x);

void from_json(const json & j, PurplePerson & x);
void to_json(json & j, const PurplePerson & x);

void from_json(const json & j, KitchenSink & x);
void to_json(json & j, const KitchenSink & x);
}
namespace nlohmann {
template <>
struct adl_serializer<std::variant<quicktype::DifferentThingClass, int64_t, std::wstring>> {
    static void from_json(const json & j, std::variant<quicktype::DifferentThingClass, int64_t, std::wstring> & x);
    static void to_json(json & j, const std::variant<quicktype::DifferentThingClass, int64_t, std::wstring> & x);
};

template <>
struct adl_serializer<std::variant<int64_t, std::wstring>> {
    static void from_json(const json & j, std::variant<int64_t, std::wstring> & x);
    static void to_json(json & j, const std::variant<int64_t, std::wstring> & x);
};
}
namespace quicktype {
    inline void from_json(const json & j, DifferentThingClass& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        x.set_name(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"name")).get<std::string>()));
    }

    inline void to_json(json & j, const DifferentThingClass & x) {
        j = json::object();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"name")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_name());
    }

    inline void from_json(const json & j, PersonElement& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        x.set_name(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"name")).get<std::string>()));
        x.set_int_or_string(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"intOrString")).get<IntOrString>());
        if (j.find("optionalValue") != j.end() && j.at("optionalValue").is_null()) throw std::runtime_error("Unexpected null");
        x.set_optional_value(get_stack_optional<bool>(j, Utf16_Utf8<std::wstring, std::string>::convert(L"optionalValue")));
    }

    inline void to_json(json & j, const PersonElement & x) {
        j = json::object();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"name")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_name());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"intOrString")] = x.get_int_or_string();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"optionalValue")] = x.get_optional_value();
    }

    inline void from_json(const json & j, PurplePerson& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        x.set_name(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"name")).get<std::string>()));
        if (j.find("intOrString") != j.end() && !j.at("intOrString").is_number_integer()) throw std::runtime_error("Expected integer");
        x.set_int_or_string(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"intOrString")).get<int64_t>());
    }

    inline void to_json(json & j, const PurplePerson & x) {
        j = json::object();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"name")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_name());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"intOrString")] = x.get_int_or_string();
    }

    inline void from_json(const json & j, KitchenSink& x) {
        if (!j.is_object()) throw std::runtime_error("Expected object");
        x.set_string_value(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"stringValue")).get<std::string>()));
        x.set_date_value(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"dateValue")).get<std::string>()));
        x.set_uuid_value(Utf16_Utf8<std::string, std::wstring>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"uuidValue")).get<std::string>()));
        x.set_name_with_spaces(get_untyped(j, Utf16_Utf8<std::wstring, std::string>::convert(L"name with spaces")));
        x.set_double_value(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"doubleValue")).get<double>());
        if (j.find("intValue") != j.end() && !j.at("intValue").is_number_integer()) throw std::runtime_error("Expected integer");
        x.set_int_value(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"intValue")).get<int64_t>());
        x.set_boolean_value(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"booleanValue")).get<bool>());
        x.set_null_value(get_untyped(j, Utf16_Utf8<std::wstring, std::string>::convert(L"nullValue")));
        x.set_tuples(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"tuples")).get<std::vector<std::vector<IntOrString>>>());
        x.set_person(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"person")).get<PurplePerson>());
        x.set_people(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"people")).get<std::vector<PersonElement>>());
        x.set_different_things(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"differentThings")).get<std::vector<DifferentThingElement>>());
        x.set_map_value(Utf16_Utf8<std::map<std::string, std::optional<int64_t>>, std::map<std::wstring, std::optional<int64_t>>>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"mapValue")).get<std::map<std::string, std::optional<int64_t>>>()));
        x.set_nullable_map_value(Utf16_Utf8<std::map<std::string, std::optional<int64_t>>, std::map<std::wstring, std::optional<int64_t>>>::convert(j.at(Utf16_Utf8<std::wstring, std::string>::convert(L"nullableMapValue")).get<std::map<std::string, std::optional<int64_t>>>()));
    }

    inline void to_json(json & j, const KitchenSink & x) {
        j = json::object();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"stringValue")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_string_value());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"dateValue")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_date_value());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"uuidValue")] = Utf16_Utf8<std::wstring, std::string>::convert(x.get_uuid_value());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"name with spaces")] = x.get_name_with_spaces();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"doubleValue")] = x.get_double_value();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"intValue")] = x.get_int_value();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"booleanValue")] = x.get_boolean_value();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"nullValue")] = x.get_null_value();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"tuples")] = x.get_tuples();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"person")] = x.get_person();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"people")] = x.get_people();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"differentThings")] = x.get_different_things();
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"mapValue")] = Utf16_Utf8<std::map<std::wstring, std::optional<int64_t>>, std::map<std::string, std::optional<int64_t>>>::convert(x.get_map_value());
        j[Utf16_Utf8<std::wstring, std::string>::convert(L"nullableMapValue")] = Utf16_Utf8<std::map<std::wstring, std::optional<int64_t>>, std::map<std::string, std::optional<int64_t>>>::convert(x.get_nullable_map_value());
    }
}
namespace nlohmann {
    inline void adl_serializer<std::variant<quicktype::DifferentThingClass, int64_t, std::wstring>>::from_json(const json & j, std::variant<quicktype::DifferentThingClass, int64_t, std::wstring> & x) {
        if (j.is_number_integer())
            x = j.get<int64_t>();
        else if (j.is_string())
            x = quicktype::Utf16_Utf8<std::string, std::wstring>::convert(j.get<std::string>());
        else if (j.is_object())
            x = j.get<quicktype::DifferentThingClass>();
        else throw std::runtime_error("Could not deserialise!");
    }

    inline void adl_serializer<std::variant<quicktype::DifferentThingClass, int64_t, std::wstring>>::to_json(json & j, const std::variant<quicktype::DifferentThingClass, int64_t, std::wstring> & x) {
        switch (x.index()) {
            case 0:
                j = std::get<quicktype::DifferentThingClass>(x);
                break;
            case 1:
                j = std::get<int64_t>(x);
                break;
            case 2:
                j = quicktype::Utf16_Utf8<std::wstring, std::string>::convert(std::get<std::wstring>(x));
                break;
            default: throw std::runtime_error("Input JSON does not conform to schema!");
        }
    }

    inline void adl_serializer<std::variant<int64_t, std::wstring>>::from_json(const json & j, std::variant<int64_t, std::wstring> & x) {
        if (j.is_number_integer())
            x = j.get<int64_t>();
        else if (j.is_string())
            x = quicktype::Utf16_Utf8<std::string, std::wstring>::convert(j.get<std::string>());
        else throw std::runtime_error("Could not deserialise!");
    }

    inline void adl_serializer<std::variant<int64_t, std::wstring>>::to_json(json & j, const std::variant<int64_t, std::wstring> & x) {
        switch (x.index()) {
            case 0:
                j = std::get<int64_t>(x);
                break;
            case 1:
                j = quicktype::Utf16_Utf8<std::wstring, std::string>::convert(std::get<std::wstring>(x));
                break;
            default: throw std::runtime_error("Input JSON does not conform to schema!");
        }
    }
}
