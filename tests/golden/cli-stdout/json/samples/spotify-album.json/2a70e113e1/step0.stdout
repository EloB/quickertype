use serde::{Serialize, Deserialize};

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct SpotifyAlbum {
    pub album_type: String,

    pub artists: Vec<Artist>,

    pub available_markets: Vec<String>,

    pub copyrights: Vec<Copyright>,

    pub external_ids: ExternalIds,

    pub external_urls: ExternalUrls,

    pub genres: Vec<Option<serde_json::Value>>,

    pub href: String,

    pub id: String,

    pub images: Vec<Image>,

    pub name: String,

    pub popularity: i64,

    pub release_date: String,

    pub release_date_precision: String,

    pub tracks: Tracks,

    #[serde(rename = "type")]
    pub spotify_album_type: String,

    pub uri: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Artist {
    pub external_urls: ExternalUrls,

    pub href: String,

    pub id: String,

    pub name: String,

    #[serde(rename = "type")]
    pub artist_type: String,

    pub uri: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExternalUrls {
    pub spotify: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Copyright {
    pub text: String,

    #[serde(rename = "type")]
    pub copyright_type: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExternalIds {
    pub upc: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Image {
    pub height: i64,

    pub url: String,

    pub width: i64,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Tracks {
    pub href: String,

    pub items: Vec<Item>,

    pub limit: i64,

    pub next: Option<serde_json::Value>,

    pub offset: i64,

    pub previous: Option<serde_json::Value>,

    pub total: i64,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Item {
    pub artists: Vec<Artist>,

    pub available_markets: Vec<String>,

    pub disc_number: i64,

    pub duration_ms: i64,

    pub explicit: bool,

    pub external_urls: ExternalUrls,

    pub href: String,

    pub id: String,

    pub name: String,

    pub preview_url: String,

    pub track_number: i64,

    #[serde(rename = "type")]
    pub item_type: String,

    pub uri: String,
}
