// Converter.java

// To use this code, add the following Maven dependency to your project:
//
//
//     com.fasterxml.jackson.core     : jackson-databind          : 2.9.0
//
//
// Import this package:
//
//     import io.quicktype.Converter;
//
// Then you can deserialize a JSON string with
//
//     KitchenSink data = Converter.fromJsonString(jsonString);

package io.quicktype;

import java.io.IOException;
import com.fasterxml.jackson.databind.*;
import com.fasterxml.jackson.databind.module.SimpleModule;
import com.fasterxml.jackson.core.JsonParser;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import java.util.*;
import java.util.Date;
import java.text.SimpleDateFormat;

public class Converter {
    // Date-time helpers

    private static final String[] DATE_TIME_FORMATS = {
            "yyyy-MM-dd'T'HH:mm:ss.SX",
            "yyyy-MM-dd'T'HH:mm:ss.S",
            "yyyy-MM-dd'T'HH:mm:ssX",
            "yyyy-MM-dd'T'HH:mm:ss",
            "yyyy-MM-dd HH:mm:ss.SX",
            "yyyy-MM-dd HH:mm:ss.S",
            "yyyy-MM-dd HH:mm:ssX",
            "yyyy-MM-dd HH:mm:ss",
            "HH:mm:ss.SZ",
            "HH:mm:ss.S",
            "HH:mm:ssZ",
            "HH:mm:ss",
            "yyyy-MM-dd",
    };

    public static Date parseAllDateTimeString(String str) {
        str = str.replaceFirst("(\\.\\d{3})\\d+", "$1");
        for (String format : DATE_TIME_FORMATS) {
            try {
                return new SimpleDateFormat(format).parse(str);
            } catch (Exception ex) {
                // Ignored
            }
        }
        return null;
    }

    public static String serializeDateTime(Date datetime) {
        return new SimpleDateFormat("yyyy-MM-dd'T'hh:mm:ssZ").format(datetime);
    }

    public static String serializeDate(Date datetime) {
        return new SimpleDateFormat("yyyy-MM-dd").format(datetime);
    }

    public static String serializeTime(Date datetime) {
        return new SimpleDateFormat("hh:mm:ssZ").format(datetime);
    }
    // Serialize/deserialize helpers

    public static KitchenSink fromJsonString(String json) throws IOException {
        return getObjectReader().readValue(json);
    }

    public static String toJsonString(KitchenSink obj) throws JsonProcessingException {
        return getObjectWriter().writeValueAsString(obj);
    }

    private static ObjectReader reader;
    private static ObjectWriter writer;

    private static void instantiateMapper() {
        ObjectMapper mapper = new ObjectMapper();
        mapper.findAndRegisterModules();
        mapper.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
        mapper.configure(DeserializationFeature.ACCEPT_FLOAT_AS_INT, false);
        mapper.configure(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS, false);
        SimpleModule module = new SimpleModule();
        module.addDeserializer(Date.class, new JsonDeserializer<Date>() {
            @Override
            public Date deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
                String value = jsonParser.getText();
                return Converter.parseAllDateTimeString(value);
            }
        });
        module.addDeserializer(Date.class, new JsonDeserializer<Date>() {
            @Override
            public Date deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
                String value = jsonParser.getText();
                return Converter.parseAllDateTimeString(value);
            }
        });
        module.addDeserializer(Date.class, new JsonDeserializer<Date>() {
            @Override
            public Date deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
                String value = jsonParser.getText();
                return Converter.parseAllDateTimeString(value);
            }
        });
        mapper.registerModule(module);
        reader = mapper.readerFor(KitchenSink.class);
        writer = mapper.writerFor(KitchenSink.class);
    }

    private static ObjectReader getObjectReader() {
        if (reader == null) instantiateMapper();
        return reader;
    }

    private static ObjectWriter getObjectWriter() {
        if (writer == null) instantiateMapper();
        return writer;
    }
}

// KitchenSink.java

package io.quicktype;

import com.fasterxml.jackson.annotation.*;
import java.util.List;
import java.util.Map;

public class KitchenSink {
    private String stringValue;
    private String dateValue;
    private String uuidValue;
    private Object nameWithSpaces;
    private double doubleValue;
    private long intValue;
    private boolean booleanValue;
    private Object nullValue;
    private List<List<IntOrString>> tuples;
    private PurplePerson person;
    private List<PersonElement> people;
    private List<DifferentThingElement> differentThings;
    private Map<String, Long> mapValue;
    private Map<String, Long> nullableMapValue;

    @JsonProperty("stringValue")
    public String getStringValue() { return stringValue; }
    @JsonProperty("stringValue")
    public void setStringValue(String value) { this.stringValue = value; }

    @JsonProperty("dateValue")
    public String getDateValue() { return dateValue; }
    @JsonProperty("dateValue")
    public void setDateValue(String value) { this.dateValue = value; }

    @JsonProperty("uuidValue")
    public String getUUIDValue() { return uuidValue; }
    @JsonProperty("uuidValue")
    public void setUUIDValue(String value) { this.uuidValue = value; }

    @JsonProperty("name with spaces")
    public Object getNameWithSpaces() { return nameWithSpaces; }
    @JsonProperty("name with spaces")
    public void setNameWithSpaces(Object value) { this.nameWithSpaces = value; }

    @JsonProperty("doubleValue")
    public double getDoubleValue() { return doubleValue; }
    @JsonProperty("doubleValue")
    public void setDoubleValue(double value) { this.doubleValue = value; }

    @JsonProperty("intValue")
    public long getIntValue() { return intValue; }
    @JsonProperty("intValue")
    public void setIntValue(long value) { this.intValue = value; }

    @JsonProperty("booleanValue")
    public boolean getBooleanValue() { return booleanValue; }
    @JsonProperty("booleanValue")
    public void setBooleanValue(boolean value) { this.booleanValue = value; }

    @JsonProperty("nullValue")
    public Object getNullValue() { return nullValue; }
    @JsonProperty("nullValue")
    public void setNullValue(Object value) { this.nullValue = value; }

    @JsonProperty("tuples")
    public List<List<IntOrString>> getTuples() { return tuples; }
    @JsonProperty("tuples")
    public void setTuples(List<List<IntOrString>> value) { this.tuples = value; }

    @JsonProperty("person")
    public PurplePerson getPerson() { return person; }
    @JsonProperty("person")
    public void setPerson(PurplePerson value) { this.person = value; }

    @JsonProperty("people")
    public List<PersonElement> getPeople() { return people; }
    @JsonProperty("people")
    public void setPeople(List<PersonElement> value) { this.people = value; }

    @JsonProperty("differentThings")
    public List<DifferentThingElement> getDifferentThings() { return differentThings; }
    @JsonProperty("differentThings")
    public void setDifferentThings(List<DifferentThingElement> value) { this.differentThings = value; }

    @JsonProperty("mapValue")
    public Map<String, Long> getMapValue() { return mapValue; }
    @JsonProperty("mapValue")
    public void setMapValue(Map<String, Long> value) { this.mapValue = value; }

    @JsonProperty("nullableMapValue")
    public Map<String, Long> getNullableMapValue() { return nullableMapValue; }
    @JsonProperty("nullableMapValue")
    public void setNullableMapValue(Map<String, Long> value) { this.nullableMapValue = value; }
}

// DifferentThingElement.java

package io.quicktype;

import java.io.IOException;
import java.io.IOException;
import com.fasterxml.jackson.core.*;
import com.fasterxml.jackson.databind.*;
import com.fasterxml.jackson.databind.annotation.*;
import com.fasterxml.jackson.core.type.*;

@JsonDeserialize(using = DifferentThingElement.Deserializer.class)
@JsonSerialize(using = DifferentThingElement.Serializer.class)
public class DifferentThingElement {
    public Long integerValue;
    public DifferentThingClass differentThingClassValue;
    public String stringValue;

    static class Deserializer extends JsonDeserializer<DifferentThingElement> {
        @Override
        public DifferentThingElement deserialize(JsonParser jsonParser, DeserializationContext deserializationContext) throws IOException, JsonProcessingException {
            DifferentThingElement value = new DifferentThingElement();
            switch (jsonParser.currentToken()) {
                case VALUE_NUMBER_INT:
                    value.integerValue = jsonParser.readValueAs(Long.class);
                    break;
                case VALUE_STRING:
                    String string = jsonParser.readValueAs(String.class);
                    value.stringValue = string;
                    break;
                case START_OBJECT:
                    value.differentThingClassValue = jsonParser.readValueAs(DifferentThingClass.class);
                    break;
                default: throw new IOException("Cannot deserialize DifferentThingElement");
            }
            return value;
        }
    }

    static class Serializer extends JsonSerializer<DifferentThingElement> {
        @Override
        public void serialize(DifferentThingElement obj, JsonGenerator jsonGenerator, SerializerProvider serializerProvider) throws IOException {
            if (obj.integerValue != null) {
                jsonGenerator.writeObject(obj.integerValue);
                return;
            }
            if (obj.differentThingClassValue != null) {
                jsonGenerator.writeObject(obj.differentThingClassValue);
                return;
            }
            if (obj.stringValue != null) {
                jsonGenerator.writeObject(obj.stringValue);
                return;
            }
            throw new IOException("DifferentThingElement must not be null");
        }
    }
}

