use serde::{Serialize, Deserialize};
use std::collections::HashMap;

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct KitchenSink {
    string_value: String,

    date_value: String,

    uuid_value: String,

    #[serde(rename = "name with spaces")]
    name_with_spaces: Option<serde_json::Value>,

    double_value: f64,

    int_value: i64,

    boolean_value: bool,

    null_value: Option<serde_json::Value>,

    tuples: Vec<Vec<IntOrString>>,

    person: PurplePerson,

    people: Vec<PersonElement>,

    different_things: Vec<DifferentThingElement>,

    map_value: HashMap<String, Option<i64>>,

    nullable_map_value: HashMap<String, Option<i64>>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
pub enum DifferentThingElement {
    DifferentThingClass(DifferentThingClass),

    Integer(i64),

    PurpleString(String),
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct DifferentThingClass {
    name: String,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct PersonElement {
    name: String,

    int_or_string: IntOrString,

    optional_value: Option<bool>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
pub enum IntOrString {
    Integer(i64),

    PurpleString(String),
}

#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct PurplePerson {
    name: String,

    int_or_string: i64,
}
