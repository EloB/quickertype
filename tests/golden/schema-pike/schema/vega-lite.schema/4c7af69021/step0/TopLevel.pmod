    retval.opacity = json["opacity"] == Standards.JSON.null ? json["opacity"] : ResolveMode_from_JSON(json["opacity"]);
    retval.shape = json["shape"] == Standards.JSON.null ? json["shape"] : ResolveMode_from_JSON(json["shape"]);
    retval.size = json["size"] == Standards.JSON.null ? json["size"] : ResolveMode_from_JSON(json["size"]);
    retval.x = json["x"] == Standards.JSON.null ? json["x"] : ResolveMode_from_JSON(json["x"]);
    retval.y = json["y"] == Standards.JSON.null ? json["y"] : ResolveMode_from_JSON(json["y"]);

    return retval;
}

class SelectionDef {
    BindUnion                     bind;      // json: "bind"
    Empty|mixed                   empty;     // json: "empty"
    array(SingleDefChannel)|mixed encodings; // json: "encodings"
    array(string)|mixed           fields;    // json: "fields"
    bool|mixed                    nearest;   // json: "nearest"
    mixed                         on;        // json: "on"
    SelectionResolution|mixed     resolve;   // json: "resolve"
    SelectionDefType              type;      // json: "type"
    Translate                     toggle;    // json: "toggle"
    BrushConfig|mixed             mark;      // json: "mark"
    Translate                     translate; // json: "translate"
    Translate                     zoom;      // json: "zoom"

    string encode_json() {
        mapping(string:mixed) json = ([
            "bind" : bind,
            "empty" : empty,
            "encodings" : encodings,
            "fields" : fields,
            "nearest" : nearest,
            "on" : on,
            "resolve" : resolve,
            "type" : type,
            "toggle" : toggle,
            "mark" : mark,
            "translate" : translate,
            "zoom" : zoom,
        ]);

        return Standards.JSON.encode(json);
    }
}

SelectionDef SelectionDef_from_JSON(mixed json) {
    SelectionDef retval = SelectionDef();

    if (arrayp(json["bind"])) error("Unexpected array");
    retval.bind = json["bind"];
    retval.empty = json["empty"] == Standards.JSON.null ? json["empty"] : Empty_from_JSON(json["empty"]);
    retval.encodings = json["encodings"];
    retval.fields = json["fields"];
    retval.nearest = json["nearest"];
    retval.on = json["on"];
    retval.resolve = json["resolve"] == Standards.JSON.null ? json["resolve"] : SelectionResolution_from_JSON(json["resolve"]);
    retval.type = SelectionDefType_from_JSON(json["type"]);
    if (arrayp(json["toggle"])) error("Unexpected array");
    retval.toggle = json["toggle"];
    retval.mark = json["mark"];
    if (arrayp(json["translate"])) error("Unexpected array");
    retval.translate = json["translate"];
    if (arrayp(json["zoom"])) error("Unexpected array");
    retval.zoom = json["zoom"];

    return retval;
}

typedef BindEnum|mapping(string:VgBinding) BindUnion;

BindUnion BindUnion_from_JSON(mixed json) {
    return json;
}

