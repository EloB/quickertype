// An object describing the data source
//
// Secondary data source to lookup in.
class Data {
    DataFormat|mixed format; // json: "format"
    mixed|string     url;    // json: "url"
    Values           values; // json: "values"
    mixed|string     name;   // json: "name"

    string encode_json() {
        mapping(string:mixed) json = ([
            "format" : format,
            "url" : url,
            "values" : values,
            "name" : name,
        ]);

        return Standards.JSON.encode(json);
    }
}

Data Data_from_JSON(mixed json) {
    Data retval = Data();

    retval.format = json["format"];
    retval.url = json["url"];
    retval.values = json["values"];
    retval.name = json["name"];

    return retval;
}

// An object that specifies the format for parsing the data file.
//
// An object that specifies the format for parsing the data values.
//
// An object that specifies the format for parsing the data.
class DataFormat {
    ParseUnion           parse;    // json: "parse"
    DataFormatType|mixed type;     // json: "type"
    mixed|string         property; // json: "property"
    mixed|string         feature;  // json: "feature"
    mixed|string         mesh;     // json: "mesh"

    string encode_json() {
        mapping(string:mixed) json = ([
            "parse" : parse,
            "type" : type,
            "property" : property,
            "feature" : feature,
            "mesh" : mesh,
        ]);

        return Standards.JSON.encode(json);
    }
}

