+// `QUICKTYPE_RESULTS=<file>` keeps going past failing tests and appends one
+// JSON line per test to <file>: fixture, sample, renderer options, status
+// (pass, fail, timeout or skip), duration and the failure.
+const RESULTS_FILE = process.env.QUICKTYPE_RESULTS;
+
+const { TimeoutError } = require("promise-timeout");
+
+// The fixtures' `timeout()` (MAX_TEST_RUNTIME_MS) rejects, as the
+// `error` of what `failWith` throws, but does not stop the test.
+function timedOut(e: unknown): boolean {
+    return (
+        e instanceof TimeoutError ||
+        (e !== null &&
+            typeof e === "object" &&
+            (e as { error?: unknown }).error instanceof TimeoutError)
+    );
+}
+
+// The processes this one started, and theirs.
+function descendants(): number[] {
+    const ps = spawnSync("ps", ["-A", "-o", "pid=,ppid="], {
+        encoding: "utf8",
+    });
+    const children = new Map<number, number[]>();
+    for (const line of (ps.stdout ?? "").split("\n")) {
+        const [pid, ppid] = line.trim().split(/\s+/).map(Number);
+        if (Number.isInteger(pid) && Number.isInteger(ppid)) {
+            children.set(ppid, [...(children.get(ppid) ?? []), pid]);
+        }
+    }
+    const result: number[] = [];
+    const queue = [process.pid];
+    for (let p = queue.pop(); p !== undefined; p = queue.pop()) {
+        for (const child of children.get(p) ?? []) {
+            result.push(child);
+            queue.push(child);
+        }
+    }
+    return result;
+}
+
+function describeError(e: unknown): unknown {
+    if (e instanceof Error) {
+        return `${e.name}: ${e.message}`;
+    }
+    if (Array.isArray(e)) {
+        return e.map(describeError);
+    }
+    if (e !== null && typeof e === "object") {
+        return _.mapValues(e as Record<string, unknown>, describeError);
+    }
+    return e;
+}
+
+async function runAndRecord(
+    fixture: Fixture,
+    sample: Sample,
+    index: number,
+    total: number,
+): Promise<void> {
+    const origin = process.cwd();
+    const shouldSkip = (
+        fixture as { shouldSkipTest?: (s: Sample) => boolean }
+    ).shouldSkipTest?.(sample);
+    const start = Date.now();
+    let status = shouldSkip === true ? "skip" : "pass";
+    let error: string | undefined;
+    try {
+        await fixture.runWithSample(sample, index, total);
+    } catch (e) {
+        status = timedOut(e) ? "timeout" : "fail";
+        error = JSON.stringify(describeError(e));
+        if (error !== undefined && error.length > 12000) {
+            error = `${error.slice(0, 12000)}...`;
+        }
+    } finally {
+        // A failure inside `inDir` leaves the run directory as the cwd.
+        process.chdir(origin);
+    }
+    fs.appendFileSync(
+        defined(RESULTS_FILE),
+        `${JSON.stringify({
+            fixture: fixture.name,
+            sample: sample.path,
+            options: sample.additionalRendererOptions,
+            status,
+            ms: Date.now() - start,
+            error,
+        })}\n`,
+    );
+    if (status === "timeout") {
+        // The test is still running, and would go on beside the next test
+        // in this worker (cwd, files, child processes).  End it: kill what
+        // it started and exit, and `inParallel` forks a fresh worker.
+        for (const pid of descendants()) {
+            try {
+                process.kill(pid, "SIGKILL");
+            } catch {
+                // Already gone.
+            }
+        }
+        process.exit(REPLACE_WORKER_EXIT_CODE);
+    }
+}
