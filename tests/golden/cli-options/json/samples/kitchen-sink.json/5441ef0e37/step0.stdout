void cJSON_DeleteKitchenSink(struct KitchenSink * x) {
    if (NULL != x) {
        if (NULL != x->StringValue) {
            cJSON_free(x->StringValue);
        }
        if (NULL != x->DateValue) {
            cJSON_free(x->DateValue);
        }
        if (NULL != x->UuidValue) {
            cJSON_free(x->UuidValue);
        }
        if (NULL != x->Tuples) {
            list_t * x1 = list_get_head(x->Tuples);
            while (NULL != x1) {
                struct IntOrString * x2 = list_get_head(x1);
                while (NULL != x2) {
                    cJSON_DeleteIntOrString(x2);
                    x2 = list_get_next(x1);
