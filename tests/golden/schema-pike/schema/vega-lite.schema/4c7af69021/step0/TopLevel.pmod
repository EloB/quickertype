    retval.shape = json["shape"] == Standards.JSON.null ? json["shape"] : ResolveMode_from_JSON(json["shape"]);
    retval.size = json["size"] == Standards.JSON.null ? json["size"] : ResolveMode_from_JSON(json["size"]);

    return retval;
}

class ScaleResolveMap {
    ResolveMode|mixed color;   // json: "color"
