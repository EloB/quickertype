class Interacinar {
    float  assapan;        // json: "assapan"
    bool   benefactorship; // json: "benefactorship"
    string triseriatim;    // json: "triseriatim"
    int    tubbing;        // json: "tubbing"
    mixed  untrimmed;      // json: "untrimmed"

    string encode_json() {
        mapping(string:mixed) json = ([
            "assapan" : assapan,
            "benefactorship" : benefactorship,
            "triseriatim" : triseriatim,
            "tubbing" : tubbing,
            "untrimmed" : untrimmed,
        ]);

        return Standards.JSON.encode(json);
    }
}

Interacinar Interacinar_from_JSON(mixed json) {
    Interacinar retval = Interacinar();

    retval.assapan = (float)json["assapan"];
    if (json["benefactorship"] != Standards.JSON.true && json["benefactorship"] != Standards.JSON.false) error("Expected bool");
    retval.benefactorship = json["benefactorship"];
    retval.triseriatim = json["triseriatim"];
    if (!intp(json["tubbing"])) error("Expected integer");
    retval.tubbing = json["tubbing"];
    retval.untrimmed = json["untrimmed"];

    return retval;
}

typedef array(int)|mapping(string:int|mixed) Jacutinga;

Jacutinga Jacutinga_from_JSON(mixed json) {
    return json;
}
