cJSON * cJSON_CreateItem(const struct Item * x) {
    cJSON * j = NULL;
    if (NULL != x) {
        if (NULL != (j = cJSON_CreateObject())) {
            if (NULL != x->artists) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "artists");
                if (NULL != j1) {
                    struct Artist * x1 = list_get_head(x->artists);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateArtist(x1));
                        x1 = list_get_next(x->artists);
                    }
                }
            }
            if (NULL != x->available_markets) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "available_markets");
                if (NULL != j1) {
                    char * x1 = list_get_head(x->available_markets);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateString(x1));
                        x1 = list_get_next(x->available_markets);
                    }
                }
            }
            cJSON_AddNumberToObject(j, "disc_number", x->disc_number);
            cJSON_AddNumberToObject(j, "duration_ms", x->duration_ms);
            cJSON_AddBoolToObject(j, "explicit", x->item_explicit);
            cJSON_AddItemToObject(j, "external_urls", cJSON_CreateExternalUrls(x->external_urls));
            if (NULL != x->href) {
                cJSON_AddStringToObject(j, "href", x->href);
            }
            else {
                cJSON_AddStringToObject(j, "href", "");
            }
            if (NULL != x->id) {
                cJSON_AddStringToObject(j, "id", x->id);
            }
            else {
                cJSON_AddStringToObject(j, "id", "");
            }
            if (NULL != x->name) {
                cJSON_AddStringToObject(j, "name", x->name);
            }
            else {
                cJSON_AddStringToObject(j, "name", "");
            }
            if (NULL != x->preview_url) {
                cJSON_AddStringToObject(j, "preview_url", x->preview_url);
            }
            else {
                cJSON_AddStringToObject(j, "preview_url", "");
            }
            cJSON_AddNumberToObject(j, "track_number", x->track_number);
            if (NULL != x->type) {
                cJSON_AddStringToObject(j, "type", x->type);
            }
            else {
                cJSON_AddStringToObject(j, "type", "");
            }
            if (NULL != x->uri) {
                cJSON_AddStringToObject(j, "uri", x->uri);
            }
            else {
                cJSON_AddStringToObject(j, "uri", "");
            }
        }
    }
    return j;
}

char * cJSON_PrintItem(const struct Item * x) {
    char * s = NULL;
    if (NULL != x) {
        cJSON * j = cJSON_CreateItem(x);
        if (NULL != j) {
            s = cJSON_Print(j);
            cJSON_Delete(j);
        }
    }
    return s;
}

void cJSON_DeleteItem(struct Item * x) {
    if (NULL != x) {
        if (NULL != x->artists) {
            struct Artist * x1 = list_get_head(x->artists);
            while (NULL != x1) {
                cJSON_DeleteArtist(x1);
                x1 = list_get_next(x->artists);
            }
            list_release(x->artists);
        }
        if (NULL != x->available_markets) {
            char * x1 = list_get_head(x->available_markets);
            while (NULL != x1) {
                cJSON_free(x1);
                x1 = list_get_next(x->available_markets);
            }
            list_release(x->available_markets);
        }
        if (NULL != x->external_urls) {
            cJSON_DeleteExternalUrls(x->external_urls);
        }
        if (NULL != x->href) {
            cJSON_free(x->href);
        }
        if (NULL != x->id) {
            cJSON_free(x->id);
        }
        if (NULL != x->name) {
            cJSON_free(x->name);
        }
        if (NULL != x->preview_url) {
            cJSON_free(x->preview_url);
        }
        if (NULL != x->type) {
            cJSON_free(x->type);
        }
        if (NULL != x->uri) {
            cJSON_free(x->uri);
        }
        cJSON_free(x);
    }
}

