+// `QUICKTYPE_RESULTS=<file>` keeps going past failing tests and appends one
+// JSON line per test to <file>: fixture, sample, renderer options, status
+// (pass, fail or skip), duration and the failure.
+const RESULTS_FILE = process.env.QUICKTYPE_RESULTS;
+
+function describeError(e: unknown): unknown {
+    if (e instanceof Error) {
+        return `${e.name}: ${e.message}`;
+    }
+    if (Array.isArray(e)) {
+        return e.map(describeError);
+    }
+    if (e !== null && typeof e === "object") {
+        return _.mapValues(e as Record<string, unknown>, describeError);
+    }
+    return e;
+}
+
+async function runAndRecord(
+    fixture: Fixture,
+    sample: Sample,
+    index: number,
+    total: number,
+): Promise<void> {
+    const origin = process.cwd();
+    const shouldSkip = (
+        fixture as { shouldSkipTest?: (s: Sample) => boolean }
+    ).shouldSkipTest?.(sample);
+    const start = Date.now();
+    let status = shouldSkip === true ? "skip" : "pass";
+    let error: string | undefined;
+    try {
+        await fixture.runWithSample(sample, index, total);
+    } catch (e) {
+        status = "fail";
+        error = JSON.stringify(describeError(e));
+        if (error !== undefined && error.length > 8000) {
+            error = `${error.slice(0, 8000)}...`;
+        }
+    } finally {
+        // A failure inside `inDir` leaves the run directory as the cwd.
+        process.chdir(origin);
+    }
+    fs.appendFileSync(
+        defined(RESULTS_FILE),
+        `${JSON.stringify({
+            fixture: fixture.name,
+            sample: sample.path,
+            options: sample.additionalRendererOptions,
+            status,
+            ms: Date.now() - start,
+            error,
+        })}\n`,
+    );
+}
