            else {
                x->DIFFERENT_THINGS = list_create(false, NULL);
            }
            if (!cJSON_HasObjectItem(j, "mapValue")) { cJSON_DeleteKitchenSink(x); return NULL; }
            if (cJSON_HasObjectItem(j, "mapValue")) {
                if (!cJSON_IsObject(cJSON_GetObjectItemCaseSensitive(j, "mapValue"))) { cJSON_DeleteKitchenSink(x); return NULL; }
                hashtable_t * x1 = hashtable_create(64, false);
                if (NULL != x1) {
                    cJSON * e1 = NULL;
                    cJSON * j1 = cJSON_GetObjectItemCaseSensitive(j, "mapValue");
                    cJSON_ArrayForEach(e1, j1) {
                        if (!cJSON_IsNull(e1) && !quicktype_cJSON_IsInteger(e1)) { cJSON_DeleteKitchenSink(x); return NULL; }
                        if (!cJSON_IsNull(e1)) {
                            int64_t * tmp = cJSON_malloc(sizeof(int64_t));
                            if (NULL != tmp) {
