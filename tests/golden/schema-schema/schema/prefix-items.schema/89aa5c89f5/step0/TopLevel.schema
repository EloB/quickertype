{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/TopLevel",
    "definitions": {
        "TopLevel": {
            "type": "object",
            "additionalProperties": {},
            "properties": {
                "open": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Open"
                    }
                },
                "tuple": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Open"
                    }
                }
            },
            "required": [
                "open",
                "tuple"
            ],
            "title": "TopLevel"
        },
        "Open": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "integer"
                }
            ],
            "title": "Open"
        }
    }
}
