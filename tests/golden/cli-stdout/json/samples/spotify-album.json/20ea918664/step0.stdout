            if (NULL != x->items) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "items");
                if (NULL != j1) {
                    struct Item * x1 = list_get_head(x->items);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateItem(x1));
                        x1 = list_get_next(x->items);
                    }
                }
            }
            cJSON_AddNumberToObject(j, "limit", x->limit);
            cJSON_AddNullToObject(j, "next");
            cJSON_AddNumberToObject(j, "offset", x->offset);
            cJSON_AddNullToObject(j, "previous");
            cJSON_AddNumberToObject(j, "total", x->total);
        }
    }
