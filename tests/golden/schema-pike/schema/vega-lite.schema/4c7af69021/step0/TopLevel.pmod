            "fontSize" : font_size,
            "fontStyle" : font_style,
            "fontWeight" : font_weight,
            "href" : href,
            "interpolate" : interpolate,
            "limit" : limit,
            "opacity" : opacity,
            "orient" : orient,
            "radius" : radius,
            "shape" : shape,
            "size" : size,
            "stroke" : stroke,
            "strokeDash" : stroke_dash,
            "strokeDashOffset" : stroke_dash_offset,
            "strokeOpacity" : stroke_opacity,
            "strokeWidth" : stroke_width,
            "style" : style,
            "tension" : tension,
            "text" : text,
            "theta" : theta,
            "type" : type,
        ]);

        return Standards.JSON.encode(json);
    }
}

MarkDef MarkDef_from_JSON(mixed json) {
    MarkDef retval = MarkDef();

    retval.align = json["align"] == Standards.JSON.null ? json["align"] : HorizontalAlign_from_JSON(json["align"]);
    if (has_index(json, "angle") && json["angle"] < 0) error("Value below minimum");
    if (has_index(json, "angle") && json["angle"] > 360) error("Value above maximum");
    retval.angle = json["angle"];
    retval.baseline = json["baseline"] == Standards.JSON.null ? json["baseline"] : VerticalAlign_from_JSON(json["baseline"]);
    retval.clip = json["clip"];
    retval.color = json["color"];
    retval.cursor = json["cursor"] == Standards.JSON.null ? json["cursor"] : Cursor_from_JSON(json["cursor"]);
    retval.dx = json["dx"];
    retval.dy = json["dy"];
    retval.fill = json["fill"];
    retval.filled = json["filled"];
    if (has_index(json, "fillOpacity") && json["fillOpacity"] < 0) error("Value below minimum");
    if (has_index(json, "fillOpacity") && json["fillOpacity"] > 1) error("Value above maximum");
    retval.fill_opacity = json["fillOpacity"];
    retval.font = json["font"];
    if (has_index(json, "fontSize") && json["fontSize"] < 0) error("Value below minimum");
    retval.font_size = json["fontSize"];
    retval.font_style = json["fontStyle"] == Standards.JSON.null ? json["fontStyle"] : FontStyle_from_JSON(json["fontStyle"]);
    if (arrayp(json["fontWeight"])) error("Unexpected array");
    retval.font_weight = json["fontWeight"];
    retval.href = json["href"];
    retval.interpolate = json["interpolate"] == Standards.JSON.null ? json["interpolate"] : Interpolate_from_JSON(json["interpolate"]);
    retval.limit = json["limit"];
    if (has_index(json, "opacity") && json["opacity"] < 0) error("Value below minimum");
    if (has_index(json, "opacity") && json["opacity"] > 1) error("Value above maximum");
    retval.opacity = json["opacity"];
    retval.orient = json["orient"] == Standards.JSON.null ? json["orient"] : Orient_from_JSON(json["orient"]);
    if (has_index(json, "radius") && json["radius"] < 0) error("Value below minimum");
    retval.radius = json["radius"];
    retval.shape = json["shape"];
    if (has_index(json, "size") && json["size"] < 0) error("Value below minimum");
    retval.size = json["size"];
    retval.stroke = json["stroke"];
    retval.stroke_dash = json["strokeDash"];
    retval.stroke_dash_offset = json["strokeDashOffset"];
    if (has_index(json, "strokeOpacity") && json["strokeOpacity"] < 0) error("Value below minimum");
    if (has_index(json, "strokeOpacity") && json["strokeOpacity"] > 1) error("Value above maximum");
    retval.stroke_opacity = json["strokeOpacity"];
    if (has_index(json, "strokeWidth") && json["strokeWidth"] < 0) error("Value below minimum");
    retval.stroke_width = json["strokeWidth"];
    retval.style = json["style"];
    if (has_index(json, "tension") && json["tension"] < 0) error("Value below minimum");
    if (has_index(json, "tension") && json["tension"] > 1) error("Value above maximum");
    retval.tension = json["tension"];
    retval.text = json["text"];
    retval.theta = json["theta"];
    retval.type = Mark_from_JSON(json["type"]);

    return retval;
}

// A string or array of strings indicating the name of custom styles to apply to the mark. A
// style is a named collection of mark property defaults defined within the [style
// configuration](mark.html#style-config). If style is an array, later styles will override
// earlier styles. Any [mark properties](encoding.html#mark-prop) explicitly defined within
// the `encoding` will override a style default.
//
// __Default value:__ The mark's name.  For example, a bar mark will have style `"bar"` by
// default.
// __Note:__ Any specified style will augment the default style. For example, a bar mark
// with `"style": "foo"` will receive from `config.style.bar` and `config.style.foo` (the
// specified style `"foo"` has higher precedence).
//
// A [mark style property](config.html#style) to apply to the title text mark.
//
// __Default value:__ `"group-title"`.
typedef string|array(string) Style;

Style Style_from_JSON(mixed json) {
    return json;
}

enum Mark {
    AREA = "area",         // json: "area"
    BAR = "bar",           // json: "bar"
    LINE = "line",         // json: "line"
    MARK_POINT = "point",  // json: "point"
    MARK_TEXT = "text",    // json: "text"
    TICK = "tick",         // json: "tick"
    RECT = "rect",         // json: "rect"
    RULE = "rule",         // json: "rule"
    CIRCLE = "circle",     // json: "circle"
    SQUARE = "square",     // json: "square"
    GEOSHAPE = "geoshape", // json: "geoshape"
}

Mark Mark_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "area"&&json != "bar"&&json != "line"&&json != "point"&&json != "text"&&json != "tick"&&json != "rect"&&json != "rule"&&json != "circle"&&json != "square"&&json != "geoshape")error("enum");return json;
}

// An object defining properties of geographic projection.
//
// Works with `"geoshape"` marks and `"point"` or `"line"` marks that have a channel (one or
// more of `"X"`, `"X2"`, `"Y"`, `"Y2"`) with type `"latitude"`, or `"longitude"`.
class Projection {
    array(float)|mixed                   center;      // json: "center"
    float|mixed                          clip_angle;  // json: "clipAngle"
    array(array(float))|mixed            clip_extent; // json: "clipExtent"
    float|mixed                          coefficient; // json: "coefficient"
    float|mixed                          distance;    // json: "distance"
    float|mixed                          fraction;    // json: "fraction"
    float|mixed                          lobes;       // json: "lobes"
    float|mixed                          parallel;    // json: "parallel"
    mapping(string:PrecisionValue)|mixed precision;   // json: "precision"
    float|mixed                          radius;      // json: "radius"
    float|mixed                          ratio;       // json: "ratio"
    array(float)|mixed                   rotate;      // json: "rotate"
    float|mixed                          spacing;     // json: "spacing"
    float|mixed                          tilt;        // json: "tilt"
    VgProjectionType|mixed               type;        // json: "type"

    string encode_json() {
        mapping(string:mixed) json = ([
            "center" : center,
            "clipAngle" : clip_angle,
            "clipExtent" : clip_extent,
            "coefficient" : coefficient,
            "distance" : distance,
            "fraction" : fraction,
            "lobes" : lobes,
            "parallel" : parallel,
            "precision" : precision,
            "radius" : radius,
            "ratio" : ratio,
            "rotate" : rotate,
            "spacing" : spacing,
            "tilt" : tilt,
            "type" : type,
        ]);

        return Standards.JSON.encode(json);
    }
}

Projection Projection_from_JSON(mixed json) {
    Projection retval = Projection();

    retval.center = json["center"];
    retval.clip_angle = json["clipAngle"];
    retval.clip_extent = json["clipExtent"];
    retval.coefficient = json["coefficient"];
    retval.distance = json["distance"];
    retval.fraction = json["fraction"];
    retval.lobes = json["lobes"];
    retval.parallel = json["parallel"];
    retval.precision = json["precision"];
    retval.radius = json["radius"];
    retval.ratio = json["ratio"];
    retval.rotate = json["rotate"];
    retval.spacing = json["spacing"];
    retval.tilt = json["tilt"];
    retval.type = json["type"] == Standards.JSON.null ? json["type"] : VgProjectionType_from_JSON(json["type"]);

    return retval;
}

// Scale, axis, and legend resolutions for layers.
//
// Defines how scales, axes, and legends from different specs should be combined. Resolve is
// a mapping from `scale`, `axis`, and `legend` to a mapping from channels to resolutions.
//
// Scale, axis, and legend resolutions for facets.
//
// Scale and legend resolutions for repeated charts.
//
// Scale, axis, and legend resolutions for vertically concatenated charts.
//
// Scale, axis, and legend resolutions for horizontally concatenated charts.
class Resolve {
    AxisResolveMap|mixed   axis;   // json: "axis"
    LegendResolveMap|mixed legend; // json: "legend"
    ScaleResolveMap|mixed  scale;  // json: "scale"

    string encode_json() {
        mapping(string:mixed) json = ([
            "axis" : axis,
            "legend" : legend,
            "scale" : scale,
        ]);

        return Standards.JSON.encode(json);
    }
}

Resolve Resolve_from_JSON(mixed json) {
    Resolve retval = Resolve();

    retval.axis = json["axis"];
    retval.legend = json["legend"];
    retval.scale = json["scale"];

    return retval;
}

class AxisResolveMap {
    ResolveMode|mixed x; // json: "x"
    ResolveMode|mixed y; // json: "y"

    string encode_json() {
        mapping(string:mixed) json = ([
            "x" : x,
            "y" : y,
        ]);

        return Standards.JSON.encode(json);
    }
}

AxisResolveMap AxisResolveMap_from_JSON(mixed json) {
    AxisResolveMap retval = AxisResolveMap();

    retval.x = json["x"] == Standards.JSON.null ? json["x"] : ResolveMode_from_JSON(json["x"]);
    retval.y = json["y"] == Standards.JSON.null ? json["y"] : ResolveMode_from_JSON(json["y"]);

    return retval;
}

enum ResolveMode {
    INDEPENDENT = "independent", // json: "independent"
    SHARED = "shared",           // json: "shared"
}

ResolveMode ResolveMode_from_JSON(mixed json) {
