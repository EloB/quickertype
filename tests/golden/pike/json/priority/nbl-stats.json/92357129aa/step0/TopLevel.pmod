    if (!intp(json["sThreePointersPercentage"])) error("Expected integer");
    retval.s_three_pointers_percentage = json["sThreePointersPercentage"];
    if (!intp(json["sTurnovers"])) error("Expected integer");
    retval.s_turnovers = json["sTurnovers"];
    if (!intp(json["sTwoPointersAttempted"])) error("Expected integer");
    retval.s_two_pointers_attempted = json["sTwoPointersAttempted"];
    if (!intp(json["sTwoPointersMade"])) error("Expected integer");
    retval.s_two_pointers_made = json["sTwoPointersMade"];
    if (!intp(json["sTwoPointersPercentage"])) error("Expected integer");
    retval.s_two_pointers_percentage = json["sTwoPointersPercentage"];
    retval.shirt_number = json["shirtNumber"];
    if (!intp(json["starter"])) error("Expected integer");
    retval.starter = json["starter"];

    return retval;
}

class Comp {
    float  s_assists_average;        // json: "sAssistsAverage"
    string s_minutes_average;        // json: "sMinutesAverage"
    float  s_points_average;         // json: "sPointsAverage"
    float  s_rebounds_total_average; // json: "sReboundsTotalAverage"

    string encode_json() {
        mapping(string:mixed) json = ([
            "sAssistsAverage" : s_assists_average,
            "sMinutesAverage" : s_minutes_average,
            "sPointsAverage" : s_points_average,
            "sReboundsTotalAverage" : s_rebounds_total_average,
        ]);

        return Standards.JSON.encode(json);
    }
}

Comp Comp_from_JSON(mixed json) {
    Comp retval = Comp();

    retval.s_assists_average = (float)json["sAssistsAverage"];
    retval.s_minutes_average = json["sMinutesAverage"];
    retval.s_points_average = (float)json["sPointsAverage"];
    retval.s_rebounds_total_average = (float)json["sReboundsTotalAverage"];

    return retval;
}

typedef int|string SMinutes;

SMinutes SMinutes_from_JSON(mixed json) {
    return json;
}

class Shot {
    ActionType action_type;  // json: "actionType"
    int        p;            // json: "p"
    int        per;          // json: "per"
    PerType    per_type;     // json: "perType"
    string     player;       // json: "player"
    int        pno;          // json: "pno"
    int        r;            // json: "r"
    string     shirt_number; // json: "shirtNumber"
    SubType    sub_type;     // json: "subType"
    int        tno;          // json: "tno"
    int        x;            // json: "x"
    int        y;            // json: "y"

    string encode_json() {
        mapping(string:mixed) json = ([
            "actionType" : action_type,
            "p" : p,
            "per" : per,
            "perType" : per_type,
            "player" : player,
            "pno" : pno,
            "r" : r,
            "shirtNumber" : shirt_number,
            "subType" : sub_type,
            "tno" : tno,
            "x" : x,
            "y" : y,
        ]);

        return Standards.JSON.encode(json);
    }
}

Shot Shot_from_JSON(mixed json) {
    Shot retval = Shot();

    retval.action_type = ActionType_from_JSON(json["actionType"]);
    if (!intp(json["p"])) error("Expected integer");
    retval.p = json["p"];
    if (!intp(json["per"])) error("Expected integer");
    retval.per = json["per"];
    retval.per_type = PerType_from_JSON(json["perType"]);
    retval.player = json["player"];
    if (!intp(json["pno"])) error("Expected integer");
    retval.pno = json["pno"];
    if (!intp(json["r"])) error("Expected integer");
    retval.r = json["r"];
    retval.shirt_number = json["shirtNumber"];
    retval.sub_type = SubType_from_JSON(json["subType"]);
    if (!intp(json["tno"])) error("Expected integer");
    retval.tno = json["tno"];
    if (!intp(json["x"])) error("Expected integer");
    retval.x = json["x"];
    if (!intp(json["y"])) error("Expected integer");
    retval.y = json["y"];

    return retval;
}

enum SubType {
    JUMPSHOT = "jumpshot", // json: "jumpshot"
    LAYUP = "layup",       // json: "layup"
    DUNK = "dunk",         // json: "dunk"
}

SubType SubType_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "jumpshot"&&json != "layup"&&json != "dunk")error("enum");return json;
}

class Totallds {
    mapping(string:Scorer) s_assists;        // json: "sAssists"
    mapping(string:Scorer) s_blocks;         // json: "sBlocks"
    mapping(string:Scorer) s_points;         // json: "sPoints"
    mapping(string:Scorer) s_rebounds_total; // json: "sReboundsTotal"
    mapping(string:Scorer) s_steals;         // json: "sSteals"

    string encode_json() {
        mapping(string:mixed) json = ([
            "sAssists" : s_assists,
            "sBlocks" : s_blocks,
            "sPoints" : s_points,
            "sReboundsTotal" : s_rebounds_total,
            "sSteals" : s_steals,
        ]);

        return Standards.JSON.encode(json);
    }
}

Totallds Totallds_from_JSON(mixed json) {
    Totallds retval = Totallds();

    retval.s_assists = json["sAssists"];
    retval.s_blocks = json["sBlocks"];
    retval.s_points = json["sPoints"];
    retval.s_rebounds_total = json["sReboundsTotal"];
    retval.s_steals = json["sSteals"];

    return retval;
}
