                if (!cJSON_IsString(cJSON_GetObjectItemCaseSensitive(j, "release_date_precision"))) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
                x->release_date_precision = strdup(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(j, "release_date_precision")));
            }
            else {
                if (NULL != (x->release_date_precision = cJSON_malloc(sizeof(char)))) {
                    x->release_date_precision[0] = '\0';
                }
            }
            if (!cJSON_HasObjectItem(j, "tracks")) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
            if (cJSON_HasObjectItem(j, "tracks")) {
                if (!cJSON_IsObject(cJSON_GetObjectItemCaseSensitive(j, "tracks"))) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
                x->tracks = cJSON_GetTracksValue(cJSON_GetObjectItemCaseSensitive(j, "tracks"));
                if (NULL == x->tracks) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
            }
            if (!cJSON_HasObjectItem(j, "type")) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
            if (cJSON_HasObjectItem(j, "type")) {
                if (!cJSON_IsString(cJSON_GetObjectItemCaseSensitive(j, "type"))) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
                x->type = strdup(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(j, "type")));
            }
            else {
                if (NULL != (x->type = cJSON_malloc(sizeof(char)))) {
                    x->type[0] = '\0';
                }
            }
            if (!cJSON_HasObjectItem(j, "uri")) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
            if (cJSON_HasObjectItem(j, "uri")) {
                if (!cJSON_IsString(cJSON_GetObjectItemCaseSensitive(j, "uri"))) { cJSON_DeleteSpotifyAlbum(x); return NULL; }
                x->uri = strdup(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(j, "uri")));
            }
            else {
                if (NULL != (x->uri = cJSON_malloc(sizeof(char)))) {
                    x->uri[0] = '\0';
                }
            }
        }
    }
    return x;
}

cJSON * cJSON_CreateSpotifyAlbum(const struct SpotifyAlbum * x) {
    cJSON * j = NULL;
    if (NULL != x) {
        if (NULL != (j = cJSON_CreateObject())) {
            if (NULL != x->album_type) {
                cJSON_AddStringToObject(j, "album_type", x->album_type);
            }
            else {
                cJSON_AddStringToObject(j, "album_type", "");
            }
            if (NULL != x->artists) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "artists");
                if (NULL != j1) {
                    struct Artist * x1 = list_get_head(x->artists);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateArtist(x1));
                        x1 = list_get_next(x->artists);
                    }
                }
            }
            if (NULL != x->available_markets) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "available_markets");
                if (NULL != j1) {
                    char * x1 = list_get_head(x->available_markets);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateString(x1));
                        x1 = list_get_next(x->available_markets);
                    }
                }
            }
            if (NULL != x->copyrights) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "copyrights");
                if (NULL != j1) {
                    struct Copyright * x1 = list_get_head(x->copyrights);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateCopyright(x1));
                        x1 = list_get_next(x->copyrights);
                    }
                }
            }
            cJSON_AddItemToObject(j, "external_ids", cJSON_CreateExternalIds(x->external_ids));
            cJSON_AddItemToObject(j, "external_urls", cJSON_CreateExternalUrls(x->external_urls));
            if (NULL != x->genres) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "genres");
                if (NULL != j1) {
                    cJSON * x1 = list_get_head(x->genres);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, quicktype_cJSON_Duplicate(x1));
                        x1 = list_get_next(x->genres);
                    }
                }
            }
            if (NULL != x->href) {
                cJSON_AddStringToObject(j, "href", x->href);
            }
            else {
                cJSON_AddStringToObject(j, "href", "");
            }
            if (NULL != x->id) {
                cJSON_AddStringToObject(j, "id", x->id);
            }
            else {
                cJSON_AddStringToObject(j, "id", "");
            }
            if (NULL != x->images) {
                cJSON * j1 = cJSON_AddArrayToObject(j, "images");
                if (NULL != j1) {
                    struct Image * x1 = list_get_head(x->images);
                    while (NULL != x1) {
                        cJSON_AddItemToArray(j1, cJSON_CreateImage(x1));
                        x1 = list_get_next(x->images);
                    }
                }
            }
            if (NULL != x->name) {
                cJSON_AddStringToObject(j, "name", x->name);
            }
            else {
                cJSON_AddStringToObject(j, "name", "");
            }
            cJSON_AddNumberToObject(j, "popularity", x->popularity);
            if (NULL != x->release_date) {
                cJSON_AddStringToObject(j, "release_date", x->release_date);
            }
            else {
                cJSON_AddStringToObject(j, "release_date", "");
            }
            if (NULL != x->release_date_precision) {
                cJSON_AddStringToObject(j, "release_date_precision", x->release_date_precision);
            }
            else {
                cJSON_AddStringToObject(j, "release_date_precision", "");
            }
            cJSON_AddItemToObject(j, "tracks", cJSON_CreateTracks(x->tracks));
            if (NULL != x->type) {
                cJSON_AddStringToObject(j, "type", x->type);
            }
            else {
                cJSON_AddStringToObject(j, "type", "");
            }
            if (NULL != x->uri) {
                cJSON_AddStringToObject(j, "uri", x->uri);
            }
            else {
                cJSON_AddStringToObject(j, "uri", "");
            }
        }
    }
    return j;
}

char * cJSON_PrintSpotifyAlbum(const struct SpotifyAlbum * x) {
    char * s = NULL;
    if (NULL != x) {
        cJSON * j = cJSON_CreateSpotifyAlbum(x);
        if (NULL != j) {
            s = cJSON_Print(j);
            cJSON_Delete(j);
        }
    }
    return s;
}

void cJSON_DeleteSpotifyAlbum(struct SpotifyAlbum * x) {
    if (NULL != x) {
        if (NULL != x->album_type) {
            cJSON_free(x->album_type);
        }
        if (NULL != x->artists) {
            struct Artist * x1 = list_get_head(x->artists);
            while (NULL != x1) {
                cJSON_DeleteArtist(x1);
                x1 = list_get_next(x->artists);
            }
            list_release(x->artists);
        }
        if (NULL != x->available_markets) {
            char * x1 = list_get_head(x->available_markets);
            while (NULL != x1) {
                cJSON_free(x1);
                x1 = list_get_next(x->available_markets);
            }
            list_release(x->available_markets);
        }
        if (NULL != x->copyrights) {
            struct Copyright * x1 = list_get_head(x->copyrights);
            while (NULL != x1) {
                cJSON_DeleteCopyright(x1);
                x1 = list_get_next(x->copyrights);
            }
            list_release(x->copyrights);
        }
        if (NULL != x->external_ids) {
            cJSON_DeleteExternalIds(x->external_ids);
        }
        if (NULL != x->external_urls) {
            cJSON_DeleteExternalUrls(x->external_urls);
        }
        if (NULL != x->genres) {
            cJSON * x1 = list_get_head(x->genres);
            while (NULL != x1) {
                cJSON_Delete(x1);
                x1 = list_get_next(x->genres);
            }
            list_release(x->genres);
        }
        if (NULL != x->href) {
            cJSON_free(x->href);
        }
        if (NULL != x->id) {
            cJSON_free(x->id);
        }
        if (NULL != x->images) {
            struct Image * x1 = list_get_head(x->images);
            while (NULL != x1) {
                cJSON_DeleteImage(x1);
                x1 = list_get_next(x->images);
            }
            list_release(x->images);
        }
        if (NULL != x->name) {
            cJSON_free(x->name);
        }
        if (NULL != x->release_date) {
            cJSON_free(x->release_date);
        }
        if (NULL != x->release_date_precision) {
            cJSON_free(x->release_date_precision);
        }
        if (NULL != x->tracks) {
            cJSON_DeleteTracks(x->tracks);
        }
        if (NULL != x->type) {
            cJSON_free(x->type);
        }
        if (NULL != x->uri) {
            cJSON_free(x->uri);
        }
        cJSON_free(x);
    }
}

