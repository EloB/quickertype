    SortUnion                                  sort;      // json: "sort"
    TimeUnit|mixed                             time_unit; // json: "timeUnit"
    Type|mixed                                 type;      // json: "type"

    string encode_json() {
        mapping(string:mixed) json = ([
            "test" : test,
            "value" : value,
            "selection" : selection,
            "aggregate" : aggregate,
            "bin" : bin,
            "field" : field,
            "legend" : legend,
            "scale" : scale,
            "sort" : sort,
            "timeUnit" : time_unit,
            "type" : type,
        ]);

        return Standards.JSON.encode(json);
    }
}

ConditionalPredicateMarkPropFieldDefClass ConditionalPredicateMarkPropFieldDefClass_from_JSON(mixed json) {
    ConditionalPredicateMarkPropFieldDefClass retval = ConditionalPredicateMarkPropFieldDefClass();

    if (arrayp(json["test"])) error("Unexpected array");
