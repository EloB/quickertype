    retval.minstep = json["minstep"];
    retval.nice = json["nice"];
    retval.step = json["step"];
    if (has_index(json, "steps") && sizeof(json["steps"]) < 1) error("Array too short");
    retval.steps = json["steps"];

    return retval;
