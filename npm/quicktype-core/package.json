{
    "name": "quicktype-core",
    "version": "24.0.0",
    "description": "The quicktype engine as a library",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "repository": "https://github.com/glideapps/quicktype",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "clean": "rm -rf dist build",
        "build": "node script/build.mjs",
        "build:ts": "node script/build.mjs --skip-wasm",
        "check:upstream": "node script/sync-upstream.mjs --check",
        "test": "node --test test/*.test.mjs",
        "test:differential": "node test/differential/run.mjs",
        "test:browser": "node test/browser/smoke.mjs"
    },
    "dependencies": {
        "@glideapps/ts-necessities": "2.2.3",
        "@types/readable-stream": "4.0.10",
        "@types/urijs": "^1.19.26",
        "browser-or-node": "^3.0.0",
        "collection-utils": "^1.0.1",
        "is-url": "^1.2.4",
        "lodash": "^4.18.1",
        "pluralize": "^8.0.0",
        "readable-stream": "4.5.2",
        "unicode-properties": "^1.4.1",
        "urijs": "^1.19.1",
        "wordwrap": "^1.0.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/browser-or-node": "^1.3.2",
        "@types/is-url": "^1.2.32",
        "@types/lodash": "^4.17.0",
        "@types/node": "~20.19.0",
        "@types/pluralize": "0.0.30",
        "@types/unicode-properties": "^1.3.2",
        "@types/wordwrap": "^1.0.3",
        "binaryen": "132.0.0",
        "esbuild": "^0.28.1",
        "typescript": "~7.0.2"
    },
    "files": [
        "dist"
    ],
    "browser": {
        "fs": false,
        "path": false
    }
}
