{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/TopLevel",
    "definitions": {
        "TopLevel": {
            "type": "object",
            "additionalProperties": {},
            "properties": {
                "optDouble": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 99.5
                },
                "optInt": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "optPattern": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                },
                "optString": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 10
                },
                "reqZeroMin": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "required": [
                "reqZeroMin"
            ],
            "title": "TopLevel"
        }
    }
}
