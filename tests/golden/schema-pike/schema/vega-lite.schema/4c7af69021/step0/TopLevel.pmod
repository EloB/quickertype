// Title configuration, which determines default properties for all [titles](title.html).
// For a full list of title configuration options, please see the [corresponding section of
// the title documentation](title.html#config).
class VgTitleConfig {
    Anchor|mixed        anchor;      // json: "anchor"
    float|mixed         angle;       // json: "angle"
    VerticalAlign|mixed baseline;    // json: "baseline"
    mixed|string        color;       // json: "color"
    mixed|string        font;        // json: "font"
    float|mixed         font_size;   // json: "fontSize"
    FontWeightUnion     font_weight; // json: "fontWeight"
    float|mixed         limit;       // json: "limit"
    float|mixed         offset;      // json: "offset"
    TitleOrient|mixed   orient;      // json: "orient"

    string encode_json() {
        mapping(string:mixed) json = ([
            "anchor" : anchor,
            "angle" : angle,
            "baseline" : baseline,
            "color" : color,
            "font" : font,
            "fontSize" : font_size,
            "fontWeight" : font_weight,
            "limit" : limit,
            "offset" : offset,
            "orient" : orient,
        ]);

        return Standards.JSON.encode(json);
    }
}

VgTitleConfig VgTitleConfig_from_JSON(mixed json) {
    VgTitleConfig retval = VgTitleConfig();

    retval.anchor = json["anchor"] == Standards.JSON.null ? json["anchor"] : Anchor_from_JSON(json["anchor"]);
    retval.angle = json["angle"];
    retval.baseline = json["baseline"] == Standards.JSON.null ? json["baseline"] : VerticalAlign_from_JSON(json["baseline"]);
    retval.color = json["color"];
    retval.font = json["font"];
    if (has_index(json, "fontSize") && json["fontSize"] < 0) error("Value below minimum");
    retval.font_size = json["fontSize"];
    if (arrayp(json["fontWeight"])) error("Unexpected array");
    retval.font_weight = json["fontWeight"];
    if (has_index(json, "limit") && json["limit"] < 0) error("Value below minimum");
    retval.limit = json["limit"];
    retval.offset = json["offset"];
    retval.orient = json["orient"] == Standards.JSON.null ? json["orient"] : TitleOrient_from_JSON(json["orient"]);

    return retval;
}

enum Anchor {
    START = "start",          // json: "start"
    ANCHOR_MIDDLE = "middle", // json: "middle"
    END = "end",              // json: "end"
}

Anchor Anchor_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "start"&&json != "middle"&&json != "end")error("enum");return json;
}

enum TitleOrient {
    ORIENT_TOP = "top",       // json: "top"
    ORIENT_BOTTOM = "bottom", // json: "bottom"
    ORIENT_LEFT = "left",     // json: "left"
    ORIENT_RIGHT = "right",   // json: "right"
}

TitleOrient TitleOrient_from_JSON(mixed json) {
    if(!zero_type(json)&&json != "top"&&json != "bottom"&&json != "left"&&json != "right")error("enum");return json;
}

